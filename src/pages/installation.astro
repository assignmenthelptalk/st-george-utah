---
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../lib/site";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Water Softener Installation in ${site.city}, ${site.stateAbbr}`}
  description={`Professional water softener installation in ${site.city}, ${site.stateAbbr}. Sized for ${site.gpgLow}–${site.gpgHigh} GPG from ${site.waterAuthority}. Free water test included. Same day service. No obligation.`}
>
  <PageHero
    breadcrumbs={[{ label: "Installation" }]}
    heading={`Water Softener Installation in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Quote" }}
  >
    <p slot="opening">
      {site.businessName} (<a href="/" class="brand-link">https://{site.domain}</a>)
      {" "}offers professional water softener installation and sizing services across {site.city} and
      {site.county}. Every installation is sized to {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG reading
      from {site.waterAuthority} and your household water usage, not a statewide estimate. Licensed and
      insured. Free in-home water hardness test included with every consultation. Written quote before any
      work begins. Same day service available.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">

      <div class="section-header">
        <p>Most {site.city} homeowners pay between <strong>$800 and $3,500</strong> for a fully installed water softener, depending on system size, water hardness, and existing plumbing.</p>
      </div>

      <div class="grid grid-3">
        <div class="card">
          <h3>$800 – $1,500</h3>
          <p>Entry-level single-tank softeners, sized for smaller households and moderate hardness.</p>
        </div>
        <div class="card">
          <h3>$1,500 – $2,500</h3>
          <p>Mid-range systems for {site.gpgLabel.toLowerCase()} water and average household sizes — the most common installation in {site.city}.</p>
        </div>
        <div class="card">
          <h3>$2,500 – $3,500</h3>
          <p>Whole-home softener/filtration combo systems for large households or additional filtration needs.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Why Local Installation Matters</h2>
        <p>Installing at the correct grain capacity for {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG water is critical — an undersized system won't fully remove hardness, while an oversized one wastes salt and water. Local installers who know {site.county}'s plumbing codes and water conditions get sizing and permitting right the first time.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>Correct Sizing</h3>
          <p>Grain capacity is calculated from your household size and {site.city}'s actual hardness reading — not a generic national average.</p>
        </div>
        <div class="card">
          <h3>Code-Compliant Plumbing</h3>
          <p>Proper bypass valves, drain lines, and electrical work matter for a system that lasts and doesn't void your home warranty.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Installation Options in {site.city}</h2>
        <p>Four situations come up most often and each has its own dedicated guide:</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>Choosing Salt-Based</h3>
          <p>Ion exchange removes hardness minerals entirely — see <a href="/salt-based-installation/">salt-based installation</a> for the full process and cost.</p>
        </div>
        <div class="card">
          <h3>Choosing Salt-Free</h3>
          <p>No sodium, no drain line, no regeneration cycle — see <a href="/salt-free-installation/">salt-free installation</a> to check the tradeoffs.</p>
        </div>
        <div class="card">
          <h3>Sizing It Correctly</h3>
          <p>Grain capacity by household size at {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG — see the <a href="/water-softener-sizing/">sizing guide</a> for the formula.</p>
        </div>
        <div class="card">
          <h3>Building New</h3>
          <p>Planning rough-in before drywall goes up — see <a href="/new-construction-installation/">new construction installation</a> for what to coordinate with your builder.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Get an Exact Installation Quote</h2>
      <p>Every {site.city} home is different. Get a free quote based on your actual water hardness and household size.</p>
      <a class="btn btn-primary" href="/quote/">Free Consultation</a>
    </div>
  </section>

  <style>
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
