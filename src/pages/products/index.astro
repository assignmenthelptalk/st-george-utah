---
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import headerImage from "../../assets/images/header-products.webp";
import { site } from "../../lib/site";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };
---

<Layout
  title={`Water Softener Systems in ${site.city}, ${site.stateAbbr}`}
  description={`Recommended water softener systems for ${site.city}, ${site.stateAbbr}. Systems selected and sized for ${site.gpgLow}–${site.gpgHigh} GPG hard water from ${site.waterAuthority}.`}
>
  <PageHero
    image={headerImage}
    breadcrumbs={[{ label: "Products" }]}
    heading={`Water Softener Systems in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Quote" }}
  >
    <p slot="opening">
      {site.businessName} (<a href="/" class="brand-link">https://{site.domain}</a>)
      {" "}offers recommended water softener systems selected and sized for {site.city}'s {site.gpgLow}
      –{site.gpgHigh} GPG hard water from {site.waterAuthority}. Every system listed is rated for
      {site.gpgLabel} water at this GPG level. Salt-free conditioners are not included. They do not remove
      hardness minerals at {site.gpgLow}–{site.gpgHigh} GPG. Free sizing consultation included with every free
      water test.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        <div class="card card-featured">
          <span class="badge">Most Popular</span>
          <h3>Salt-Based Water Softener</h3>
          <p>Removes hardness minerals at {site.gpgLow}–{site.gpgHigh} GPG — the most effective option for {site.city}'s water, supplied by {site.waterAuthority}.</p>
          <ul class="feature-list">
            <li>Sized specifically for {site.gpgLow}–{site.gpgHigh} GPG hardness</li>
            <li>Removes calcium and magnesium, not just crystallizes them</li>
            <li>Protects water heaters and appliances from scale buildup</li>
            <li>Backed by a manufacturer warranty</li>
            <li>Free water hardness test included with every quote</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateSoftener} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Consultation →</a>
          </div>
        </div>

        <div class="card">
          <h3>Softener + Whole-Home Filter Combo</h3>
          <p>Pairs hardness removal with whole-home filtration for chlorine, sediment, and other contaminants carried through {site.waterAuthority}'s {site.waterSource} supply.</p>
          <ul class="feature-list">
            <li>Everything the standalone softener includes, plus filtration</li>
            <li>Removes chlorine taste and odor at every tap</li>
            <li>Reduces sediment carried through {site.waterSource}</li>
            <li>One system, one installation, one warranty</li>
            <li>Sized to {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG hardness</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateCombo} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Consultation →</a>
          </div>
        </div>

        <div class="card">
          <h3>Reverse Osmosis System</h3>
          <p>Under-sink drinking water purification for {site.city} homes. The cleanest possible glass of water from your tap.</p>
          <ul class="feature-list">
            <li>Removes dissolved solids standard filtration misses</li>
            <li>Improves the taste of drinking and cooking water</li>
            <li>Pairs with a softener for complete water treatment</li>
            <li>Compact under-sink installation</li>
            <li>Independent of {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG softening system</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateRO} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Consultation →</a>
          </div>
        </div>
      </div>
      <p class="disclosure">Some links above are affiliate links. We may earn a commission at no extra cost to you if you purchase through them.</p>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>Which System Size Does a {site.city} Home Need?</h2>
        <p>At {site.gpgLow}–{site.gpgHigh} GPG, system capacity should match household size — an undersized softener regenerates too often, while an oversized one wastes salt and water.</p>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr><th>Household Size</th><th>Grain Capacity</th><th>Regeneration Frequency</th></tr>
          </thead>
          <tbody>
            <tr><td>1–2 people</td><td>32,000 grains</td><td>Every 7–10 days</td></tr>
            <tr><td>3–4 people</td><td>48,000 grains</td><td>Every 5–7 days</td></tr>
            <tr><td>5+ people</td><td>64,000 grains</td><td>Every 4–6 days</td></tr>
          </tbody>
        </table>
      </div>
      <p class="section-footnote">Sizing guidance based on typical residential use at {site.city}'s hardness level — confirm your exact reading with {site.waterAuthority} or request a free in-home test.</p>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Ready for Soft Water in {site.city}?</h2>
      <a class="btn btn-primary" href="/quote/">Book a Free Consultation →</a>
    </div>
  </section>

  <style>
    .disclosure { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 24px; }
    .table-scroll { overflow-x: auto; }
    .section-footnote { font-size: 0.9375rem; color: var(--color-text-muted); margin-top: 24px; text-align: center; }
    .final-cta { text-align: center; }

    .grid-3 { align-items: stretch; }
    .card { display: flex; flex-direction: column; }
    .card-featured { position: relative; border: 1.5px solid var(--color-accent); }
    .card-featured .badge {
      position: absolute;
      top: -12px;
      left: 24px;
      background: var(--color-accent);
      color: #ffffff;
    }
    .feature-list { list-style: none; margin: 16px 0 20px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .feature-list li {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      padding-left: 22px;
      position: relative;
    }
    .feature-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 7px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-primary);
    }
    .card-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: auto; padding-top: 4px; }
    .card-secondary-cta {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--color-primary);
      text-decoration: none;
      transition: color var(--duration-micro) ease;
    }
    .card-secondary-cta:hover { color: var(--color-accent); }
    .card-secondary-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; border-radius: 2px; }
    .card-secondary-cta:active { color: var(--color-accent-dark); }
  </style>
</Layout>
