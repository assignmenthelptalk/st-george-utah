---
import Layout from "../../components/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../lib/site";

const primaryCta = site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER"
  ? { href: `tel:${site.phoneNumber}`, text: `📞 ${site.phoneNumber}` }
  : { href: "/contact/", text: "📞 Call for a Free Consultation" };

const faqs = [
  {
    q: "How much does whole home filtration cost?",
    a: "Whole home filtration typically adds a few hundred dollars on top of a standalone softener, depending on the filtration stage and household plumbing. Request a free quote for an exact number sized to your home.",
  },
  {
    q: "What is the best whole home filtration system for hard water?",
    a: "The best fit is a combo unit sized for your local GPG hardness and rated for the specific contaminants in your water supply — not just a generic best-seller list. Check the manufacturer's capacity and certification specs before buying.",
  },
  {
    q: "Does whole home filtration remove chlorine and sediment, not just hardness?",
    a: "Yes. A plain softener removes calcium and magnesium only. A whole-home filtration system adds a carbon-based filtration stage at the same install point to also address taste, odor, and particulates.",
  },
  {
    q: "Can I add whole home filtration to an existing softener?",
    a: "Yes, a retrofit is possible, though a single combo unit installed at your home's original point of entry is more common and simpler to maintain than adding a second, separate unit.",
  },
];
---

<Layout
  title={`Whole Home Filtration in ${site.city}, ${site.stateAbbr}`}
  description={`Whole-home water filtration for ${site.city}: what it removes, cost, and how to get one installed.`}
>
  <PageHero
    breadcrumbs={[{ label: "Whole Home Filtration" }]}
    heading={`Whole Home Filtration in ${site.city}, ${site.stateAbbr} | Trusted Local Specialists`}
    primaryCta={primaryCta}
    secondaryCta={{ href: "/quote/", text: "Get a Free Quote" }}
  >
    <p slot="opening">
      {site.businessName}
      {" "}offers whole home filtration installation and service across {site.city} and {site.county}. A
      softener plus whole-home carbon filter combination addresses both hardness minerals and chlorine,
      sediment, and other contaminants from {site.waterAuthority} supply water. One system, one installation
      point, one maintenance schedule. Free consultation included. Same day service available.
    </p>
  </PageHero>

  <section class="section">
    <div class="container">

      <div class="section-header">
        <p>A whole-home filtration system adds a carbon-based filtration stage to a standard water softener, treating chlorine, sediment, and other contaminants that hardness removal alone leaves behind. At {site.gpgLow}-{site.gpgHigh} GPG, a combo unit is the only single-install option that addresses both the hardness and the taste-and-clarity side of a {site.city} home's water supply at once.</p>
      </div>

      <div class="grid grid-2">
        <div class="card card-featured">
          <span class="badge">Recommended</span>
          <h3>Softener + Whole-Home Filter Combo</h3>
          <p>Pairs hardness removal with whole-home filtration for chlorine, sediment, and other contaminants carried through {site.waterAuthority}'s {site.waterSource} supply.</p>
          <ul class="feature-list">
            <li>Everything a standalone softener includes, plus filtration</li>
            <li>Removes chlorine taste and odor at every tap</li>
            <li>One system, one installation, one warranty</li>
            <li>Sized to {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG hardness</li>
          </ul>
          <div class="card-ctas">
            <a class="btn btn-primary btn-sm" href={site.affiliateCombo} target="_blank" rel="noopener noreferrer sponsored">Check Price &amp; Availability</a>
            <a class="card-secondary-cta" href="/quote/">Get a Free Consultation →</a>
          </div>
        </div>
      </div>
      <p class="disclosure">Some links above are affiliate links. We may earn a commission at no extra cost to you if you purchase through them.</p>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <h2>Whole Home Filtration Cost</h2>
        <p>Whole home filtration costs more than a standalone softener because of the added filtration stage, scaling with household size and plumbing layout. Request a free quote for the exact number — no fixed price without seeing the household first.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Do You Need a Combo System, or Is a Softener Alone Enough?</h2>
        <p>If hardness is your only concern, a standalone softener handles it on its own. If chlorine taste, odor, or sediment also bother you, a combo system treats both from a single install point. Explore our <a href="/products/">full system comparison</a> to see which fits your home.</p>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header center">
        <h2>Whole Home Filtration Questions</h2>
      </div>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container final-cta">
      <h2>Ready for Whole Home Filtration in {site.city}?</h2>
      <p>Check price and availability, or request a free consultation to size the right system for your home.</p>
      <a class="btn btn-primary" href="/quote/">Get a Free Consultation →</a>
    </div>
  </section>

  <style>
    .card-featured { position: relative; border: 1.5px solid var(--color-accent); }
    .card-featured .badge {
      position: absolute;
      top: -12px;
      left: 24px;
      background: var(--color-accent);
      color: #ffffff;
    }
    .feature-list { list-style: none; margin: 16px 0 20px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .feature-list li {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      padding-left: 22px;
      position: relative;
    }
    .feature-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 7px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-primary);
    }
    .card-ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin-top: auto; padding-top: 4px; }
    .card-secondary-cta {
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.875rem;
      color: var(--color-primary);
      text-decoration: none;
      transition: color var(--duration-micro) ease;
    }
    .card-secondary-cta:hover { color: var(--color-accent); }
    .card-secondary-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; border-radius: 2px; }
    .disclosure { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 24px; }
    .faq-list { max-width: 760px; margin: 24px auto 0; }
    .final-cta { text-align: center; }
    .final-cta p { max-width: 48ch; margin: 0 auto 24px; }
  </style>
</Layout>
