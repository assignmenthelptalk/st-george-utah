---
/**
 * Renders every imported content page (hubs, services, guides, towns).
 * Content lives in src/data/pages/*.md, generated by `npm run import-content`
 * from the Local-SEO-Toolkit project. The homepage is src/pages/index.astro.
 */
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ContentProse from "../components/ContentProse.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import PageSchema from "../components/PageSchema.astro";
import { site } from "../lib/site";

export function getStaticPaths() {
  const modules = import.meta.glob("../data/pages/*.md", { eager: true }) as Record<string, any>;
  const pages = Object.values(modules);
  const bySlug = new Map<string, any>(pages.map((p) => [p.frontmatter.slug, p]));

  const crumbsFor = (page: any) => {
    const trail: Array<{ label: string; href?: string }> = [{ label: page.frontmatter.crumb }];
    let parent = page.frontmatter.parentSlug as string | null;
    while (parent && parent !== "/") {
      const hub = bySlug.get(parent);
      if (!hub) break;
      trail.unshift({ label: hub.frontmatter.crumb, href: hub.frontmatter.slug });
      parent = hub.frontmatter.parentSlug;
    }
    return trail;
  };

  return pages
    .filter((p) => p.frontmatter.slug !== "/")
    .map((page) => ({
      params: { slug: (page.frontmatter.slug as string).replace(/^\/|\/$/g, "") },
      props: { page, crumbs: crumbsFor(page) },
    }));
}

const { page, crumbs } = Astro.props;
const { Content, frontmatter: fm } = page;

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/images/*.webp", { eager: true });
const leadImage = fm.leadImage ? images[`../assets/images/${fm.leadImage.file}`]?.default : undefined;

// Service schema for service and location pages. Location pages name their town as the area served.
const isLocation = fm.pageType === "geo";
const service = ["core-service", "service", "geo"].includes(fm.pageType)
  ? { name: fm.crumb as string, area: isLocation ? String(fm.crumb).replace(/^.* in /, "").replace(/,\s*[A-Z]{2}$/, "") : site.city }
  : undefined;

const telHref = `tel:${site.phoneNumber.replace(/[^\d+]/g, "")}`;
const primaryCta = { href: telHref, text: `📞 ${site.phoneNumber}` };
// Only claims the business can back up. Add licence or same-day chips once confirmed.
const badges = ["✓ Free Estimate", "✓ No Obligation", `✓ Serving ${site.city}, ${site.stateAbbr}`];
---

<Layout title={fm.title} fullTitle={fm.seoTitle} description={fm.description}>
  <PageSchema service={service} faq={fm.faq} />
  <PageHero
    breadcrumbs={crumbs}
    heading={fm.title}
    primaryCta={primaryCta}
    secondaryCta={{ href: "#estimate", text: "Get a Free Estimate" }}
    badges={badges}
  >
    <p slot="opening" set:html={fm.openingHtml} />
  </PageHero>

  {fm.pageType === "geo-hub" && <ServiceAreaMap />}

  <section class="section">
    <div class="container">
      {leadImage && <Image src={leadImage} alt={fm.leadImage.alt} width={1200} class="lead-image" />}
      <ContentProse>
        <Content />
      </ContentProse>
    </div>
  </section>

  <section class="section section-dark cta-band">
    <div class="container cta-band-inner">
      <h2>Ready for softer water in {site.city}?</h2>
      <p>Request a free estimate or call {site.businessName} to talk through your home and your water.</p>
      <div class="cta-band-actions">
        <a class="btn btn-primary" href="#estimate">Get a Free Estimate</a>
        <a class="cta-band-phone" href={telHref}>{site.phoneNumber}</a>
      </div>
    </div>
  </section>

  <style>
    .lead-image {
      display: block;
      width: 100%;
      max-width: 780px;
      height: auto;
      margin: 0 auto 2.2em;
      border-radius: var(--radius-brand);
      box-shadow: var(--shadow-card);
    }
    .cta-band { margin-top: 24px; }
    .cta-band-inner { text-align: center; }
    .cta-band-inner p { max-width: 52ch; margin: 0 auto 24px; }
    .cta-band-actions { display: flex; gap: 20px; align-items: center; justify-content: center; flex-wrap: wrap; }
    .cta-band-phone {
      color: #ffffff;
      font-weight: 700;
      font-size: 1.15rem;
      text-decoration: none;
    }
    .cta-band-phone:hover { color: var(--color-accent-light); }
  </style>
</Layout>
