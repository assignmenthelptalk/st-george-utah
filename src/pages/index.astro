---
import Layout from "../components/Layout.astro";
import LocalSchema from "../components/LocalSchema.astro";
import StGeorgeMap from "../components/StGeorgeMap.astro";
import { Image } from "astro:assets";
import homeHero from "../assets/images/home-hero.webp";
import homeInstallation from "../assets/images/home-installation.webp";
import homeHardWater from "../assets/images/home-hard-water.webp";
import homeBestSystem from "../assets/images/header-products.webp";
import homeResin from "../assets/images/header-resin-bed-replacement.webp";
import { site } from "../lib/site";

const services = [
  { emoji: "💧", name: "Water Quality Testing", href: "/water-quality/", detail: `Free in-home hardness test for ${site.city} homes.` },
  { emoji: "🧪", name: "Hard Water Treatment", href: "/hard-water/", detail: `Stop scale buildup on fixtures and appliances.` },
  { emoji: "🔧", name: "Installation", href: "/installation/", detail: `Sized correctly for ${site.city}'s ${site.gpgLow}-${site.gpgHigh} GPG water.` },
  { emoji: "🛠️", name: "Repair", href: "/repair/", detail: `Diagnosis and repair for all major softener brands.` },
  { emoji: "⚖️", name: "System Comparison", href: "/comparison/", detail: `Salt-based vs salt-free, sized for your household.` },
];

const faqs = [
  {
    q: `How hard is the water in ${site.city}?`,
    a: `${site.city} water tests at ${site.gpgLow}-${site.gpgHigh} GPG, classified as ${site.gpgLabel}. ${site.waterAuthority} delivers this ${site.waterSource} supply to every ${site.city} home.`,
  },
  {
    q: `Do I need a water softener in ${site.city}?`,
    a: `At ${site.gpgLow}-${site.gpgHigh} GPG, a salt-based ion exchange softener is the only system that fully removes calcium and magnesium at this hardness level.`,
  },
  {
    q: `How much does water softener installation cost in ${site.city}?`,
    a: `Cost depends on household size and grain capacity required. We provide a free no-obligation quote after a free in-home water test.`,
  },
  {
    q: `How long does installation take?`,
    a: `Most residential installations complete in a single visit of three to five hours, including testing the output before leaving.`,
  },
  {
    q: `Does ${site.city} water damage appliances?`,
    a: `Yes. Scale from hard water reduces water heater efficiency and shortens the life of dishwashers and washing machines. A softener installed at the main entry point protects every appliance.`,
  },
];
---

<Layout
  title={`Water Softener Installation in ${site.city}, ${site.stateAbbr}`}
  fullTitle={`${site.businessName} | Installation & Repair`}
  description={`Water softener installation and repair in ${site.city}, ${site.stateAbbr}. ${site.city} water tests at ${site.gpgLow}–${site.gpgHigh} GPG (${site.gpgLabel}). Free in-home water test available. Same day service across ${site.city} and ${site.county}.`}
>
  <LocalSchema />

  <!-- 1. Hero — two-column light layout (SPSSassignment.help-style), image slot on the right.
       A visitor arriving from a "water softener [city]" search should recognize the product
       immediately, so this slot expects a real photo of an installed system, not an abstract
       graphic — see watersofteneroftampa.com's hero for the reference implementation. -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-text">
        <div class="hero-badges">
          <span class="hero-badge">✓ Licensed &amp; Insured</span>
          <span class="hero-badge">✓ Free Water Test</span>
          <span class="hero-badge">✓ Same Day Service</span>
          <span class="hero-badge">✓ No Obligation</span>
        </div>

        <h1>{site.businessName}: Installation, Repair &amp; Free Water Testing</h1>

        <h3 class="hero-subheading">Professional Water Softener Installation and Repair in {site.city}</h3>

        <p class="hero-p">
          {site.businessName} specializes in water softener installation, repair, and maintenance for
          homes and businesses dealing with hard water.
        </p>

        <p class="hero-p">
          In {site.city}, water typically tests at {site.gpgLow} to {site.gpgHigh} GPG, classified as
          {" "}{site.gpgLabel} by {site.waterAuthority}. {site.waterSource}, leaving calcium and magnesium
          deposits on fixtures, water heaters, and dishwashers within weeks. Free in-home water testing is
          available.
        </p>

        <div class="hero-actions">
          {site.phoneNumber && site.phoneNumber !== "PHONE_NUMBER" ? (
            <a href={`tel:${site.phoneNumber}`} class="hero-phone-btn">
              📞 {site.phoneNumber}
            </a>
          ) : (
            <a href="/contact/" class="hero-phone-btn">
              📞 Call for a Free Consultation
            </a>
          )}
          <a href="/water-quality/" class="hero-secondary-btn">Check Your Water Hardness →</a>
        </div>
      </div>

      <div class="hero-media">
        <Image
          src={homeHero}
          alt={`Water softener system installed in a ${site.city}, ${site.stateAbbr} home`}
          width={700}
          height={600}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. Services grid — 5 tiles -->
  <section class="section">
    <div class="container">
      <div class="section-header center">
        <h2>Water Softener Services in {site.city}, {site.stateAbbr}</h2>
      </div>
      <div class="grid grid-services">
        {services.map((s) => (
          <a class="service-tile" href={s.href}>
            <span class="service-tile-emoji" aria-hidden="true">{s.emoji}</span>
            <h3>{s.name}</h3>
            <p>{s.detail}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. GPG data — two column, text left, stat right -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container gpg-data-grid">
      <div>
        <h2>{site.city}'s Water Hardness Reading</h2>
        <p>
          According to {site.waterAuthority}, {site.city} water holds steady at {site.gpgLow}-{site.gpgHigh} GPG
          citywide, classified as {site.gpgLabel} by the Water Quality Association. This reading comes from
          {site.waterSource}, and it stays consistent across every neighbourhood {site.city} homes sit in,
          including {site.neighbourhoods.slice(0, 3).join(", ")}.
        </p>
      </div>
      <div class="gpg-stat-card">
        <span class="gpg-stat-number">{site.gpgLow}-{site.gpgHigh}</span>
        <span class="gpg-stat-label">GPG &middot; {site.gpgLabel}</span>
      </div>
    </div>
  </section>

  <!-- 4. Alternating image-text 1 of 4 — text left, image right -->
  <!-- Best water softener system — keyword section, H2 links to /products/ -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Best Water Softener for {site.state}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            The best water softener system for {site.city} is a salt-based ion exchange unit sized to the
            area's {site.gpgLow}-{site.gpgHigh} GPG water. According to {site.waterAuthority}, softener settings
            between {site.gpgLow} and {site.gpgHigh} grains per gallon give the most effective treatment. We
            compare salt-based, salt-free and filtration options for your household size and budget, then
            recommend one system and give you a free quote.
          </p>
          <a class="underline-link" href="/products/">See the Best Water Softener for {site.state}</a>
        </div>
        <div class="service-section-media">
          <Image src={homeBestSystem} alt={`Water softener, filter and reverse osmosis systems available in ${site.city}, ${site.stateAbbr}`} width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title"><a class="h2-link" href="/installation/">Water Softener Installation in {site.city}, {site.state}</a></h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            Every water softener installation in {site.city} is sized to the local {site.gpgLow}-{site.gpgHigh}
            GPG reading and your household's water use, not a statewide estimate. Our technician sets the
            bypass, drain and brine line, programs the control head, and tests the water before leaving. Most
            installations finish in a single visit, and we walk you through the settings and salt refills before we go. A free in-home water test comes with every consultation.
          </p>
        </div>
        <div class="service-section-media">
          <Image src={homeInstallation} alt={`Water softener installation in ${site.city}, ${site.stateAbbr}`} width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Alternating image-text 2 of 4 — image left, text right -->
  <section class="section">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Hard Water Effects in {site.city}, {site.stateAbbr}</h2>
      <div class="service-section-grid service-section-grid-reverse">
        <div class="service-section-text">
          <p>
            At {site.gpgLow}-{site.gpgHigh} GPG, hard water leaves calcium and magnesium deposits on fixtures,
            inside appliances, and inside supply lines within weeks. A whole-home softener stops this at the
            source rather than treating the symptoms one fixture at a time.
          </p>
          <a class="service-learn-more" href="/hard-water/">See Hard Water Effects →</a>
        </div>
        <div class="service-section-media">
          <Image src={homeHardWater} alt={`Hard water effects in ${site.city}, ${site.stateAbbr}`} width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Resin replacement — plain H2, underlined link to /resin-bed-replacement/ below the copy -->
  <section class="section" style="background: var(--color-surface);">
    <div class="service-section-wrapper">
      <h2 class="service-section-title">Water Softener Resin Replacement in {site.city}, {site.state}</h2>
      <div class="service-section-grid">
        <div class="service-section-text">
          <p>
            Softener resin beads trap the calcium and magnesium in your water, and they wear out after years
            of heavy use. Spotted dishes, returning scale and soft water that feels hard again are the usual
            signs. With {site.city} water at {site.gpgLow}-{site.gpgHigh} GPG, resin works harder than most.
            Replacing the resin bed often costs less than a new softener, and we test your water first to confirm the real cause.
          </p>
          <a class="underline-link" href="/resin-bed-replacement/">See Resin Bed Replacement in {site.city}</a>
        </div>
        <div class="service-section-media">
          <Image src={homeResin} alt={`Fresh water softener resin beads being poured into a tank in ${site.city}, ${site.stateAbbr}`} width={600} height={400} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <StGeorgeMap />

  <!-- 7. Service areas — conditional, only renders with QDP-verified entries -->
  {site.serviceAreas.filter((a) => a.qdp.verified && a.qdp.verdict === "PASS").length > 0 && (
    <section class="homepage-service-areas">
      <div class="homepage-service-areas-inner">
        <h2>Areas We Serve Near {site.city}, {site.stateAbbr}</h2>
        <p>We serve {site.city} and surrounding {site.county} communities.</p>
        <div class="homepage-sa-grid">
          {site.serviceAreas
            .filter((a) => a.qdp.verified && a.qdp.verdict === "PASS")
            .map((area) => (
              <a href={`/${area.slug}/`} class="homepage-sa-card">
                <span class="sa-card-city">{area.city}</span>
                <span class="sa-card-detail">
                  {area.distanceFromPrimary} &middot; {area.gpgLow}-{area.gpgHigh} GPG
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  )}

  <!-- 8. Why Choose Us — bullet list, no cards -->
  <section class="section" style="background: var(--color-surface);">
    <div class="container why-choose-us">
      <h2>Why {site.city} Homeowners Choose Us</h2>
      <ul class="why-choose-list">
        <li>Sized specifically for {site.city}'s {site.gpgLow}-{site.gpgHigh} GPG water, not a generic estimate</li>
        <li>Free in-home water hardness test with every consultation</li>
        <li>Honest recommendation — repair, replace, or install, based on your actual system and water</li>
        <li>No obligation, no sales pressure, pricing confirmed before any work begins</li>
        <li>Local service across {site.city} and {site.county}</li>
      </ul>
    </div>
  </section>

  <!-- 9. FAQ accordion — details/summary, no JavaScript -->
  <section class="homepage-faq-section">
    <div class="homepage-faq-inner">
      <div class="homepage-faq-header">
        <h2>Water Softener Questions, Answered</h2>
        <p>Common questions from {site.city} homeowners about hard water and water softener installation.</p>
      </div>

      <div class="homepage-faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>

      <div class="faq-footer-link">
        <a href="/faq/">See all FAQs →</a>
      </div>
    </div>
  </section>

  <!-- 10. Slim CTA bar -->
  <section class="homepage-cta-bar">
    <div class="homepage-cta-bar-inner">
      <p>
        {site.city} water tests at {site.gpgLow}-{site.gpgHigh} GPG. Free in-home water test available.
      </p>
      <a href="/contact/" class="cta-bar-btn">Get a Free Quote →</a>
    </div>
  </section>

  <style>
    /* ---------- 1. Hero — two-column light layout ---------- */
    .hero-section {
      background: linear-gradient(180deg, #ffffff 0%, var(--color-primary-light) 100%);
      padding: clamp(48px, 8vw, 88px) 24px;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
    }
    .hero-badge {
      font-family: var(--font-body);
      font-size: 12px;
      font-weight: 600;
      color: var(--color-primary-dark, var(--color-primary));
      background: var(--color-primary-light);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full, 9999px);
      padding: 4px 12px;
    }
    .hero-section h1 {
      color: var(--color-text);
      font-size: clamp(32px, 4.2vw, 48px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      margin-bottom: 20px;
    }
    .hero-subheading {
      font-family: var(--font-body);
      font-style: italic;
      font-weight: 600;
      color: var(--color-accent);
      font-size: clamp(17px, 1.6vw, 20px);
      margin: 0 0 16px;
    }
    .hero-p {
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.75;
      color: var(--color-text-muted);
      max-width: 56ch;
      margin: 0 0 32px;
    }
    .hero-actions { display: flex; gap: 16px; flex-wrap: wrap; }
    .hero-phone-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--color-primary);
      color: #ffffff;
      border-radius: var(--radius-brand);
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 700;
      text-decoration: none;
      box-shadow: var(--shadow-card);
      transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
    }
    .hero-phone-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-floating); background: var(--color-accent); }
    .hero-phone-btn:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
    .hero-phone-btn:active { transform: scale(0.98); }
    .hero-secondary-btn {
      display: inline-flex;
      align-items: center;
      padding: 14px 24px;
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-brand);
      background: #ffffff;
      color: var(--color-text);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      transition: background-color 150ms ease, border-color 150ms ease;
    }
    .hero-secondary-btn:hover { background: var(--color-primary-light); border-color: var(--color-primary); }
    .hero-secondary-btn:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
    .hero-media { display: flex; justify-content: center; }
    .hero-media img {
      width: 100%;
      height: auto;
      border-radius: var(--radius-lg);
    }
    @media (max-width: 900px) {
      .hero-grid { grid-template-columns: 1fr; gap: 32px; }
      .hero-media { order: -1; }
    }

    /* ---------- 2. Services grid ---------- */
    .grid-services { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 32px; }
    .service-tile {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 24px;
      background: var(--surface-elevated);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
    }
    .service-tile:hover { border-color: var(--color-primary); transform: translateY(-2px); box-shadow: var(--shadow-card); }
    .service-tile:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    .service-tile-emoji { font-size: 28px; }
    .service-tile h3 { color: var(--surface-footer); margin: 0; }
    .service-tile p { font-size: 14px; color: var(--color-text-muted); margin: 0; }

    /* ---------- 3. GPG data ---------- */
    .gpg-data-grid {
      display: grid;
      grid-template-columns: 1fr 280px;
      gap: 40px;
      align-items: center;
    }
    .gpg-stat-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px;
      background: var(--surface-footer);
      border-radius: var(--radius-lg);
      text-align: center;
    }
    .gpg-stat-number {
      font-family: var(--font-heading);
      font-size: 48px;
      color: #ffffff;
      line-height: 1;
    }
    .gpg-stat-label {
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: var(--color-accent-light, var(--color-accent));
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 8px;
    }
    @media (max-width: 720px) {
      .gpg-data-grid { grid-template-columns: 1fr; }
    }

    /* ---------- 4 & 5. Alternating image-text sections ---------- */
    .service-section-wrapper { max-width: 1000px; margin: 0 auto; }
    .service-section-title {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 28px;
      line-height: 1.2;
      width: 100%;
    }
    .service-section-copy {
      max-width: 760px;
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--color-text-muted, inherit);
    }
    .underline-link {
      display: inline-block;
      font-weight: 600;
      color: var(--color-primary);
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-thickness: 2px;
    }
    .underline-link:hover { color: var(--color-accent); }
    .underline-link:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; border-radius: 2px; }
    .h2-link { color: inherit; text-decoration: none; }
    .h2-link:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: 6px; }
    .h2-link:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 4px; border-radius: 2px; }
    .service-section-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }
    .service-section-text { order: 1; }
    .service-section-media { order: 2; }
    .service-section-grid-reverse .service-section-text { order: 2; }
    .service-section-grid-reverse .service-section-media { order: 1; }
    .service-section-media img {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--radius-lg);
    }
    .service-learn-more {
      display: inline-block;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 13px;
      color: var(--color-accent);
      text-decoration: none;
      margin-top: 12px;
    }
    .service-learn-more:hover { text-decoration: underline; }
    .service-learn-more:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    @media (max-width: 860px) {
      .service-section-title { font-size: clamp(20px, 5vw, 28px); margin-bottom: 20px; }
      .service-section-grid { grid-template-columns: 1fr; gap: 24px; }
      .service-section-grid .service-section-text,
      .service-section-grid .service-section-media,
      .service-section-grid-reverse .service-section-text,
      .service-section-grid-reverse .service-section-media {
        order: initial;
      }
    }

    /* ---------- 7. Service areas (only rendered when serviceAreas is non-empty) ---------- */
    .homepage-service-areas { padding: 72px 24px; background: var(--surface-base); }
    .homepage-service-areas-inner { max-width: 960px; margin: 0 auto; text-align: center; }
    .homepage-service-areas h2 {
      font-family: var(--font-heading);
      font-size: clamp(24px, 3.5vw, 38px);
      letter-spacing: -0.02em;
      color: var(--surface-footer);
      margin-bottom: 12px;
    }
    .homepage-service-areas p {
      font-family: var(--font-body);
      font-size: 16px;
      color: var(--color-text-muted);
      margin-bottom: 32px;
    }
    .homepage-sa-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }
    .homepage-sa-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding: 20px 24px;
      background: var(--color-surface);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-lg);
      text-decoration: none;
      transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    }
    .homepage-sa-card:hover { border-color: var(--color-primary); transform: translateY(-3px); box-shadow: var(--shadow-card); }
    .homepage-sa-card:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
    .sa-card-city { font-family: var(--font-heading); font-size: 18px; color: var(--surface-footer); }
    .sa-card-detail { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); }

    /* ---------- 8. Why Choose Us — bullet list, no cards ---------- */
    .why-choose-us { max-width: 760px; }
    .why-choose-us h2 { text-align: center; margin-bottom: 24px; }
    .why-choose-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .why-choose-list li {
      position: relative;
      padding-left: 28px;
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.6;
      color: var(--color-text-muted);
    }
    .why-choose-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      top: 0;
      color: var(--color-primary);
      font-weight: 700;
    }

    /* ---------- 9. FAQ accordion ---------- */
