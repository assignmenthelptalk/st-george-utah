---
/**
 * ContentProse: typography wrapper for imported markdown pages.
 * Scoped styles reach the rendered markdown through :global selectors.
 * [NEEDS DATA] / [VERIFY] markers render as <mark class="data-gap"> and are
 * deliberately loud so unresolved facts cannot be missed in review.
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 780px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    margin: 2.6em 0 0.6em;
    padding-top: 0.9em;
    border-top: 3px solid var(--color-accent);
    max-width: 32ch;
  }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) {
    font-size: 1.3rem;
    margin: 1.8em 0 0.4em;
  }
  .prose :global(p) { margin: 0 0 1.1em; line-height: 1.75; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.4em; padding-left: 1.4em; }
  /* Tailwind's preflight resets list styles; restore them for article copy */
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 0.55em; line-height: 1.7; }
  .prose :global(li::marker) { color: var(--color-accent); font-weight: 700; }
  .prose :global(strong) { color: var(--color-text); }

  .prose :global(a) {
    color: var(--color-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose :global(a:hover) { color: var(--color-accent-dark); }

  /* Trust-layer callouts ("Not a good fit if...", "What owners tell us") */
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 18px 22px;
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius-brand) var(--radius-brand) 0;
    box-shadow: var(--shadow-card);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Comparison / price tables */
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
    background: var(--surface-base);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-brand);
    overflow: hidden;
    display: block;
    overflow-x: auto;
  }
  .prose :global(th) {
    background: var(--color-primary);
    color: #ffffff;
    text-align: left;
    padding: 12px 14px;
    font-weight: 600;
  }
  .prose :global(td) {
    padding: 12px 14px;
    border-top: 1px solid var(--color-border);
    vertical-align: top;
  }
  .prose :global(tr:nth-child(even) td) { background: var(--surface-elevated); }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.8em 0;
    border-radius: var(--radius-brand);
    box-shadow: var(--shadow-card);
  }

  /* Unresolved facts: loud on purpose */
  .prose :global(mark.data-gap),
  :global(mark.data-gap) {
    background: #fff3b0;
    color: #5c4300;
    padding: 1px 6px;
    border-radius: 4px;
    outline: 1px dashed #b88700;
    font-size: 0.9em;
    font-weight: 600;
  }

  /* Every section heading is a full-width navy band. The box-shadow and clip-path paint the band edge to
     edge without extra markup or a 100vw width, so there is no horizontal scroll. */
  .prose > :global(h2),
  .prose > :global(h2:first-child) {
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    max-width: none;
    border-top: 0;
    padding: 2rem 1rem;
    margin: 3rem 0 2rem;
    box-shadow: 0 0 0 100vmax var(--color-primary);
    clip-path: inset(0 -100vmax);
  }
  /* Homepage services: a 3-column card grid that breaks out of the 780px text column */
  .prose :global(.svc-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem 2rem;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.svc-card > p:first-child) { margin: 0 0 1rem; }
  .prose :global(.svc-card img) { margin: 0; aspect-ratio: 3 / 2; object-fit: cover; box-shadow: none; }
  .prose :global(.svc-card h3) { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .prose :global(.svc-card p) { font-size: 0.97rem; line-height: 1.65; margin: 0; }
  @media (max-width: 900px) { .prose :global(.svc-grid) { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .prose :global(.svc-grid) { grid-template-columns: 1fr; } }

  /* Homepage installation steps: photo on the left, "Step N: Title" blocks on the right */
  .prose :global(.steps-split) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem;
    align-items: start;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.steps-photo > p) { margin: 0; }
  .prose :global(.steps-photo img) { margin: 0; aspect-ratio: 4 / 5; object-fit: cover; }
  .prose :global(.steps-list h3) { margin: 0 0 0.45rem; font-size: 1.3rem; }
  .prose :global(.steps-list h3:not(:first-child)) { margin-top: 1.9rem; }
  .prose :global(.steps-list p) { margin: 0; }
  @media (max-width: 800px) { .prose :global(.steps-split) { grid-template-columns: 1fr; gap: 1.5rem; } }

  /* Homepage "issues" block: tall photo on the left, two columns of titled text blocks on the right */
  .prose :global(.issues-split) {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2.5rem;
    align-items: start;
    width: min(1100px, calc(100vw - 2rem));
    margin: 1.8rem 0 1.8rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.issues-photo) { position: sticky; top: 6.5rem; }
  .prose :global(.issues-photo > p) { margin: 0; }
  .prose :global(.issues-photo img) { margin: 0; aspect-ratio: 4 / 5; object-fit: cover; }
  .prose :global(.issues-grid) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 2.2rem; }
  .prose :global(.issue-item h3) { margin: 0 0 0.45rem; font-size: 1.2rem; }
  .prose :global(.issue-item p) { margin: 0; font-size: 0.97rem; line-height: 1.65; }
  @media (max-width: 900px) { .prose :global(.issues-split) { grid-template-columns: 1fr; gap: 1.5rem; } .prose :global(.issues-photo) { position: static; } }
  @media (max-width: 600px) { .prose :global(.issues-grid) { grid-template-columns: 1fr; } }

  /* Homepage "why us" block: photo on the left; heading (not a band), bullets and a button on the right */
  .prose :global(.why-split) {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3rem;
    align-items: center;
    width: min(1100px, calc(100vw - 2rem));
    margin: 2rem 0 2rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.why-photo > p) { margin: 0; }
  .prose :global(.why-photo img) { margin: 0; aspect-ratio: 4 / 5; object-fit: cover; }
  .prose :global(.why-text h2) {
    text-align: left;
    max-width: none;
    margin: 0 0 1rem;
    padding: 0;
    border-top: 0;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
  }
  .prose :global(.why-text ul) { margin: 0 0 1.4rem; }
  .prose :global(.why-text li) { font-size: 0.98rem; margin-bottom: 0.5em; line-height: 1.6; }
  .prose :global(.why-text p:last-child) { margin: 0; }
  .prose :global(.why-text p:last-child a) {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 0.85rem 1.7rem;
    border-radius: var(--radius-brand);
    font-weight: 700;
    text-decoration: none;
  }
  .prose :global(.why-text p:last-child a:hover) { background: var(--color-accent-dark); color: #fff; }
  @media (max-width: 800px) { .prose :global(.why-split) { grid-template-columns: 1fr; gap: 1.5rem; } }

  /* FAQ: question rows that open on click (<details>), on a light panel, like the roofing-site accordion */
  .prose :global(.faq-list) { background: #eef1f5; padding: 1rem; border-radius: var(--radius-brand); margin: 0 0 2rem; }
  .prose :global(.faq-item) { background: #fff; margin: 0 0 3px; border-radius: 4px; }
  .prose :global(.faq-item:last-child) { margin-bottom: 0; }
  .prose :global(.faq-item > summary) {
    list-style: none;
    cursor: pointer;
    padding: 0.95rem 3rem 0.95rem 1.2rem;
    font-weight: 600;
    color: var(--color-primary);
    position: relative;
  }
  .prose :global(.faq-item > summary::-webkit-details-marker) { display: none; }
  .prose :global(.faq-item > summary::after) {
    content: "";
    position: absolute;
    right: 1.3rem;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--color-accent);
    border-bottom: 2px solid var(--color-accent);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.15s;
  }
  .prose :global(.faq-item[open] > summary::after) { transform: translateY(-30%) rotate(-135deg); }
  .prose :global(.faq-item > summary:hover) { background: var(--color-primary-light); }
  .prose :global(.faq-item > summary:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -2px; }
  .prose :global(.faq-item > p) { margin: 0 0 0.9rem; padding: 0 1.2rem; font-size: 0.98rem; }
  .prose :global(.faq-item > p:last-child) { margin-bottom: 1.1rem; }

  @media (max-width: 640px) {
    .prose { font-size: 1rem; }
    .prose :global(h2) { max-width: none; }
  }
</style>
