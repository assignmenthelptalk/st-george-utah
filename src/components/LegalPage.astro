---
/**
 * LegalPage: shared shell for the Privacy Policy and Terms of Service pages. Wording lives in the pages;
 * every business detail comes from site.config.ts. noindex so the thin legal pages never compete with service pages.
 */
import Layout from "./Layout.astro";
import { site } from "../lib/site";

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props;
---

<Layout title={title} fullTitle={`${title} | ${site.businessName}`} description={description} noindex>
  <section class="section legal-page">
    <div class="container">
      <h1>{title}</h1>
      <p class="legal-updated">Last updated: {updated}</p>
      <div class="legal-body"><slot /></div>
    </div>
  </section>

  <style>
    .legal-page { padding-block: clamp(48px, 8vw, 96px); }
    .legal-page .container { max-width: 820px; }
    .legal-updated { color: var(--color-text-muted); margin-bottom: 32px; }
    .legal-body :global(h2) { font-size: 1.35rem; margin: 36px 0 12px; color: var(--color-primary); }
    .legal-body :global(p), .legal-body :global(li) { line-height: 1.7; color: var(--color-text); }
    .legal-body :global(ul) { padding-left: 1.25rem; margin: 0 0 16px; }
    .legal-body :global(a) { color: var(--color-primary); text-decoration: underline; }
  </style>
</Layout>
