---
/**
 * NeighbourhoodMap: split panel (map left, "Neighbourhood Report" right), the same design as
 * albuquerquewatersoftener.com. Pins and report text come from src/data/neighbourhoods.json, which
 * `npm run import-content` copies from the strategy folder's neighbourhood-map.json. With no pins the
 * component renders nothing, so a fresh clone builds without it.
 *
 *   { "hardness": { "value": "15.1", "unit": "GPG", "label": "Very Hard", "short": "15.1 GPG avg (2018)",
 *                   "intro": "...", "reportNote": "...", "footnote": "..." },
 *     "issues": ["..."],
 *     "neighbourhoods": [ { "name": "Gruene", "lat": 29.73, "lng": -98.10, "issues": ["optional override"] } ] }
 *
 * The view is framed once around the pins and then locked (no zoom, drag or scroll zoom). Tiles are plain
 * OpenStreetMap with a CSS inversion; do not switch to CARTO or Stadia (both need an API key).
 * [NEEDS DATA] / [VERIFY] markers render as <mark class="data-gap">, like the page copy.
 */
import { site } from "../lib/site";
import data from "../data/neighbourhoods.json";

interface Hood { name: string; lat: number; lng: number; issues?: string[] }
interface MapData {
  hardness?: { value: string; unit: string; label: string; short: string; intro: string; reportNote: string; footnote: string } | null;
  issues?: string[];
  neighbourhoods?: Hood[];
}

const d = data as MapData;
const hoods = d.neighbourhoods ?? [];
const hardness = d.hardness;
const hasMap = hoods.length > 0 && Boolean(hardness);

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const withMarkers = (s: string) => esc(s).replace(/\[(?:NEEDS DATA|VERIFY)[^\]]*\]/g, (m) => `<mark class="data-gap">${m}</mark>`);

const payload = JSON.stringify({
  hardness,
  issues: d.issues ?? [],
  neighbourhoods: hoods.map((h) => ({ ...h, issues: h.issues ?? d.issues ?? [] })),
});
---

{hasMap && hardness && (
  <section class="city-map-section" id="neighbourhood-map">
    <div class="city-map-inner">
      <div class="city-map-header">
        <h2>{site.city} Neighbourhood Water Hardness</h2>
        <p set:html={withMarkers(hardness.intro)} />
      </div>

      <div class="city-map-panel">
        <div class="city-map-left">
          <div id="city-map" data-map={payload}></div>
          <div class="map-legend" aria-hidden="true">
            <span class="legend-selected">● Selected Area</span>
            <span class="legend-available">○ Available Data</span>
          </div>
        </div>

        <div class="city-map-right">
          <div class="report-header">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="white" aria-hidden="true">
              <path d="M13 2L4.09 12.26h6.65L9.61 22 20 11.74h-6.65z"></path>
            </svg>
            Neighbourhood Report
          </div>

          <div class="report-body">
            <div class="report-default" id="report-default">
              <div class="report-default-icon">
                <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#CBD5E1" stroke-width="1.5" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <p>Click a pin on the map to see the hardness report for your neighbourhood.</p>
            </div>

            <div class="report-active" id="report-active" style="display:none">
              <div class="report-top">
              <div class="report-field">
                <span class="field-label">NEIGHBOURHOOD</span>
                <span class="field-value" id="report-name"></span>
              </div>

              <div class="report-field">
                <span class="field-label">HARDNESS LEVEL</span>
                <div class="gpg-row">
                  <span class="gpg-number">{hardness.value}</span>
                  <span class="gpg-unit">{hardness.unit}</span>
                  <span class="gpg-badge">{hardness.label.toUpperCase()}</span>
                </div>
              </div>
              </div>

              <div class="report-wqa"><div class="wqa-note">ℹ️ <Fragment set:html={withMarkers(hardness.reportNote)} /></div></div>

              <div class="report-issues-wrapper">
                <p class="issues-heading" id="issues-heading"></p>
                <ul class="report-issues" id="report-issues"></ul>
              </div>

              <a href="#estimate" class="report-cta" id="report-cta">Free Consultation →</a>
            </div>
          </div>
        </div>
      </div>

      <p class="map-footnote" set:html={withMarkers(hardness.footnote)} />
    </div>
  </section>
)}

<style>
  /* Tile inversion (dark navy). Scoped to the tile pane so markers and popups are unaffected. */
  :global(#city-map .leaflet-tile-pane) {
    filter: invert(1) hue-rotate(190deg) brightness(1.18) contrast(0.85) saturate(0.65);
  }

  .city-map-section {
    padding: 0 24px 48px;
    background: var(--surface-elevated);
  }
  .city-map-inner { max-width: 1100px; margin: 0 auto; }
  .city-map-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .city-map-header h2 {
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    padding: 2rem 1rem;
    margin: 0 0 1.4rem;
    border: 0;
    box-shadow: 0 0 0 100vmax var(--color-primary);
    clip-path: inset(0 -100vmax);
  }
  .city-map-header p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }
  .city-map-section :global(mark.data-gap) { background: #fef08a; color: #713f12; padding: 0 3px; border-radius: 3px; font-style: normal; }

  .city-map-panel {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 20px;
    height: 420px;
  }
  .city-map-left {
    position: relative;
    height: 100%;
  }
  #city-map {
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(15, 110, 120, 0.15);
    background: var(--surface-footer);
  }

  .map-legend {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(10, 46, 51, 0.85);
    backdrop-filter: blur(4px);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 1000;
    pointer-events: none;
  }
  .legend-selected { font-family: var(--font-body); font-size: 12px; font-weight: 500; color: #60a5fa; }
  .legend-available { font-family: var(--font-body); font-size: 12px; font-weight: 500; color: rgba(255, 255, 255, 0.55); }

  :global(.map-pin-default) {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease, transform 150ms ease;
  }
  :global(.map-pin-default:hover) { border-color: white; background: rgba(255, 255, 255, 0.28); transform: scale(1.15); }
  :global(.map-pin-active) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #2563eb;
    border: 3px solid white;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    position: relative;
  }
  :global(.map-pin-pulse) {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.18);
    animation: pin-pulse 2s ease-out infinite;
    pointer-events: none;
  }
  @keyframes pin-pulse {
    0% { transform: scale(1); opacity: 0.6; }
    100% { transform: scale(2); opacity: 0; }
  }

  :global(.map-tooltip-wrapper) { background: transparent !important; border: none !important; box-shadow: none !important; padding: 0 !important; }
  :global(.map-tooltip-wrapper::before) { display: none !important; }
  :global(.map-hover-tooltip) {
    background: white;
    border-radius: 10px;
    padding: 10px 14px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25), 0 1px 4px rgba(0, 0, 0, 0.15);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    min-width: 120px;
    text-align: center;
  }
  :global(.tooltip-name) { font-family: var(--font-body); font-size: 13px; font-weight: 700; color: #111827; white-space: nowrap; }
  :global(.tooltip-gpg) { font-family: var(--font-body); font-size: 12px; color: #6b7280; font-weight: 500; }

  :global(.map-label-popup .leaflet-popup-content-wrapper) { background: white; border-radius: var(--radius-xl); padding: 0; box-shadow: 0 2px 12px rgba(0, 0, 0, 0.2); }
  :global(.map-label-popup .leaflet-popup-content) { margin: 8px 16px; font-family: var(--font-body); font-size: 13px; font-weight: 600; color: #111827; }
  :global(.map-label-popup .leaflet-popup-tip) { background: white; }

  .city-map-right {
    background: var(--surface-base);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .report-header {
    background: #2563eb;
    color: white;
    padding: 11px 18px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .report-body {
    padding: 10px 18px;
    overflow-y: auto;
    flex: 1;
  }
  .report-default {
    text-align: center;
    padding: 40px 16px;
  }
  .report-default-icon { margin-bottom: 16px; }
  .report-default p { font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: #9ca3af; }
  .report-top { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: start; }
  .report-field {
    margin-bottom: 6px;
  }
  .field-label {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #9ca3af;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .field-value {
    font-family: var(--font-heading);
    font-size: 19px;
    color: #111827;
    display: block;
  }
  .gpg-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .gpg-number {
    font-family: var(--font-heading);
    font-size: 34px;
    color: #111827;
    line-height: 1;
  }
  .gpg-unit {
    font-family: var(--font-body);
    font-size: 15px;
    color: #6b7280;
    font-weight: 500;
  }
  .gpg-badge {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: #fee2e2;
    color: #991b1b;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .wqa-note {
    background: var(--color-primary-light);
    border-radius: var(--radius-md);
    padding: 8px 10px;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-primary-dark, var(--color-primary));
    line-height: 1.45;
    margin-bottom: 8px;
    font-style: italic;
  }
  .issues-heading {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #374151;
    margin: 0 0 4px;
  }
  .report-issues {
    list-style: none;
    padding: 0;
    margin: 0 0 10px;
  }
  .report-issues li {
    font-family: var(--font-body);
    font-size: 13px;
    color: #6b7280;
    padding: 3px 0;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.4;
  }
  .report-issues li::before { content: "•"; color: var(--color-accent); font-weight: bold; flex-shrink: 0; }
  .report-cta {
    display: block;
    padding: 10px 18px;
    background: var(--color-accent);
    color: white;
    text-align: center;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(230, 81, 0, 0.28);
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .report-cta:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(230, 81, 0, 0.38); }
  .report-cta:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }

  .map-footnote {
    margin: 20px auto 0;
    text-align: center;
    font-family: var(--font-body);
    font-size: 13px;
    color: #9ca3af;
    line-height: 1.6;
    max-width: 640px;
  }

  @media (max-width: 768px) {
    .city-map-panel { grid-template-columns: 1fr; height: auto; }
    .city-map-left { height: 280px; }
    .city-map-right { order: -1; height: auto; }
    .report-body { overflow: visible; }
    .report-top { grid-template-columns: 1fr; gap: 0; }
    .gpg-number { font-size: 30px; }
    .city-map-section { padding: 0 16px 40px; }
  }
</style>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  interface Hood { name: string; lat: number; lng: number; issues: string[] }

  const mapEl = document.getElementById("city-map");
  if (mapEl?.dataset.map) {
    const { hardness, neighbourhoods } = JSON.parse(mapEl.dataset.map) as {
      hardness: { short: string };
      neighbourhoods: Hood[];
    };
    const coords = (h: Hood): [number, number] => [h.lat, h.lng];
    const text = (s: string) => Object.assign(document.createElement("span"), { textContent: s }).innerHTML;

    // Static map: no zoom controls, wheel/touch/double-click zoom or panning. Framed once around the
    // pins and then locked.
    const map = L.map(mapEl, {
      zoomControl: false,
      dragging: false,
      scrollWheelZoom: false,
      doubleClickZoom: false,
      touchZoom: false,
      boxZoom: false,
      keyboard: false,
      zoomSnap: 0.25,
      attributionControl: true,
    });
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: "abc",
      maxZoom: 19,
    }).addTo(map);

    const pinBounds = L.latLngBounds(neighbourhoods.map(coords));
    const frameMap = () => {
      map.invalidateSize();
      map.setMinZoom(1);
      map.setMaxZoom(18);
      map.fitBounds(pinBounds, { padding: [48, 48], animate: false });
      const lockedZoom = map.getZoom();
      map.setMinZoom(lockedZoom);
      map.setMaxZoom(lockedZoom);
    };
    frameMap();
    window.addEventListener("resize", frameMap);
    window.addEventListener("load", frameMap, { once: true });
    const watcher = new ResizeObserver(() => {
      if (mapEl.clientHeight > 0 && mapEl.clientWidth > 0) {
        frameMap();
        watcher.disconnect();
      }
    });
    watcher.observe(mapEl);

    const defaultIcon = () =>
      L.divIcon({ className: "", html: '<div class="map-pin-default"></div>', iconSize: [22, 22], iconAnchor: [11, 11], popupAnchor: [0, -14] });
    const activeIcon = () =>
      L.divIcon({
        className: "",
        html: `<div class="map-pin-active"><span class="map-pin-pulse"></span><svg viewBox="0 0 24 24" width="12" height="12" fill="white"><path d="M13 2L4.09 12.26h6.65L9.61 22 20 11.74h-6.65z"/></svg></div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14],
        popupAnchor: [0, -18],
      });

    const reportDefault = document.getElementById("report-default");
    const reportActive = document.getElementById("report-active");
    const reportName = document.getElementById("report-name");
    const issuesHeading = document.getElementById("issues-heading");
    const reportIssues = document.getElementById("report-issues");
    const reportCta = document.getElementById("report-cta");

    let activeMarker: L.Marker | null = null;
    let activePopup: L.Popup | null = null;
    const markers: L.Marker[] = [];

    for (const hood of neighbourhoods) {
      const marker = L.marker(coords(hood), { icon: defaultIcon(), title: hood.name }).addTo(map);
      markers.push(marker);
      marker.bindTooltip(
        `<div class="map-hover-tooltip"><span class="tooltip-name">${text(hood.name)}</span><span class="tooltip-gpg">${text(hardness.short)}</span></div>`,
        { permanent: false, direction: "bottom", offset: [0, 8], opacity: 1, className: "map-tooltip-wrapper" },
      );

      marker.on("click", () => {
        marker.closeTooltip();
        if (activeMarker && activeMarker !== marker) activeMarker.setIcon(defaultIcon());
        if (activePopup) map.closePopup(activePopup);

        marker.setIcon(activeIcon());
        activeMarker = marker;
        activePopup = L.popup({ closeButton: false, className: "map-label-popup", offset: [0, -12], autoPan: false })
          .setLatLng(coords(hood))
          .setContent(`<strong>${text(hood.name)}</strong>`)
          .openOn(map);

        if (reportDefault) reportDefault.style.display = "none";
        if (reportActive) {
          reportActive.style.display = "block";
          reportActive.style.opacity = "0";
          reportActive.style.transform = "translateY(6px)";
          requestAnimationFrame(() => {
            reportActive.style.transition = "opacity 220ms ease, transform 220ms ease";
            reportActive.style.opacity = "1";
            reportActive.style.transform = "translateY(0)";
          });
        }
        if (reportName) reportName.textContent = hood.name;
        if (issuesHeading) issuesHeading.textContent = `Common issues in ${hood.name}:`;
        if (reportIssues) reportIssues.innerHTML = hood.issues.map((i) => `<li>${text(i)}</li>`).join("");
        if (reportCta) reportCta.textContent = `Free Consultation for ${hood.name} →`;
      });
    }

    // Open with the first neighbourhood selected so the report is never empty.
    markers[0]?.fire("click");
  }
</script>
