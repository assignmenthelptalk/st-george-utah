---
import { site } from "../lib/site";
---

<section
  class="system-tour-section"
  data-city={site.city}
  data-gpg-low={site.gpgLow}
  data-gpg-high={site.gpgHigh}
  data-water-authority={site.waterAuthority}
  data-water-source={site.waterSource}
>
  <div class="system-tour-inner">

    <div class="system-tour-header">
      <h2>How a Water Softener Works</h2>
      <p>A step-by-step look at how a salt-based softener removes {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG hardness from every tap in your home.</p>
    </div>

    <div class="tour-steps-row" role="tablist" aria-label="Water softener system steps">

      <button class="tour-step-btn active" data-step="0" role="tab" aria-selected="true" aria-controls="tour-panel">
        <span class="step-number">01</span>
        <span class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <span class="step-title">Pre-Filtration</span>
      </button>

      <div class="step-connector" aria-hidden="true"></div>

      <button class="tour-step-btn" data-step="1" role="tab" aria-selected="false" aria-controls="tour-panel">
        <span class="step-number">02</span>
        <span class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </span>
        <span class="step-title">Ion Exchange</span>
      </button>

      <div class="step-connector" aria-hidden="true"></div>

      <button class="tour-step-btn" data-step="2" role="tab" aria-selected="false" aria-controls="tour-panel">
        <span class="step-number">03</span>
        <span class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </span>
        <span class="step-title">Regeneration</span>
      </button>

      <div class="step-connector" aria-hidden="true"></div>

      <button class="tour-step-btn" data-step="3" role="tab" aria-selected="false" aria-controls="tour-panel">
        <span class="step-number">04</span>
        <span class="step-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
        </span>
        <span class="step-title">Soft Water</span>
      </button>

    </div>

    <div class="tour-panel-wrapper" id="tour-panel" role="tabpanel">
      <div class="tour-panel">

        <div class="panel-left" id="panel-left">
          <div class="panel-step-badge" id="panel-badge">Step 01</div>
          <h3 class="panel-title" id="panel-title">Pre-Filtration</h3>
          <p class="panel-subtitle" id="panel-subtitle">Sediment and particles removed first</p>
          <p class="panel-description" id="panel-description"></p>
          <div class="panel-detail-box" id="panel-detail-box">
            <p id="panel-detail"></p>
          </div>
          <div class="panel-stat">
            <span class="stat-value" id="stat-value">5</span>
            <span class="stat-unit" id="stat-unit">microns</span>
            <span class="stat-label" id="stat-label">particle size removed</span>
          </div>
        </div>

        <div class="panel-right">
          <div class="panel-illustration" id="panel-illustration"></div>
        </div>

      </div>
    </div>

    <div class="tour-progress" aria-hidden="true">
      <button class="progress-dot active" data-dot="0" aria-label="Go to step 1"></button>
      <button class="progress-dot" data-dot="1" aria-label="Go to step 2"></button>
      <button class="progress-dot" data-dot="2" aria-label="Go to step 3"></button>
      <button class="progress-dot" data-dot="3" aria-label="Go to step 4"></button>
    </div>

    <div class="tour-nav">
      <button class="tour-nav-btn" id="tour-prev" disabled aria-label="Previous step">
        ← Previous
      </button>
      <button class="tour-nav-btn primary" id="tour-next" aria-label="Next step">
        Next Step →
      </button>
    </div>

    <div class="tour-final-cta" id="tour-final-cta" style="display:none">
      <p>Ready to stop {site.city}'s {site.gpgLow}–{site.gpgHigh} GPG water from damaging your home?</p>
      <a href="/quote/" class="tour-cta-btn">Get a Free Water Test &amp; Quote →</a>
    </div>

  </div>
</section>

<style>
  .system-tour-section {
    padding: 80px 24px;
    background: var(--surface-elevated);
  }
  .system-tour-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .system-tour-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .system-tour-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 42px);
    letter-spacing: -0.03em;
    color: var(--surface-footer);
  }
  .system-tour-header p {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Steps row */
  .tour-steps-row {
    display: flex;
    align-items: center;
    margin-bottom: 28px;
    overflow-x: auto;
    padding-bottom: 4px;
    gap: 0;
  }
  .step-connector {
    flex: 1;
    height: 2px;
    background: var(--color-border);
    min-width: 16px;
    transition: background-color 300ms ease;
  }
  .step-connector.completed { background: var(--color-primary); }

  .tour-step-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 18px;
    background: var(--surface-base);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    cursor: pointer;
    flex-shrink: 0;
    min-width: 110px;
    transition: border-color 200ms ease,
                background-color 200ms ease,
                transform 200ms cubic-bezier(0.34,1.56,0.64,1);
  }
  .tour-step-btn:hover:not(.active) {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .tour-step-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    transform: translateY(-2px);
  }
  .tour-step-btn.completed {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
  }
  .tour-step-btn:active { transform: scale(0.98); }
  .tour-step-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .step-number {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #9CA3AF;
  }
  .tour-step-btn.active    .step-number { color: rgba(255,255,255,0.70); }
  .tour-step-btn.completed .step-number { color: var(--color-primary); }
  .step-icon {
    color: #9CA3AF;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tour-step-btn.active    .step-icon { color: white; }
  .tour-step-btn.completed .step-icon { color: var(--color-primary); }
  .step-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.3;
  }
  .tour-step-btn.active    .step-title { color: white; }
  .tour-step-btn.completed .step-title { color: var(--color-primary); }

  /* Panel wrapper */
  .tour-panel-wrapper {
    background: var(--surface-base);
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin-bottom: 24px;
  }
  .tour-panel {
    display: grid;
    grid-template-columns: 1fr 300px;
    min-height: 380px;
  }

  .panel-left { padding: 40px; }
  .panel-step-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .panel-title {
    font-family: var(--font-heading);
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--surface-footer);
    margin-bottom: 6px;
  }
  .panel-subtitle {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 20px;
  }
  .panel-description {
    font-family: var(--font-body);
    font-size: 15px;
    color: #374151;
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .panel-detail-box {
    background: var(--surface-elevated);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 6px 6px 0;
    padding: 12px 14px;
    margin-bottom: 24px;
  }
  .panel-detail-box p {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }
  .panel-stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: 40px;
    color: var(--color-primary);
    line-height: 1;
  }
  .stat-unit {
    font-family: var(--font-body);
    font-size: 18px;
    color: var(--color-primary);
    font-weight: 600;
  }
  .stat-label {
    font-family: var(--font-body);
    font-size: 13px;
    color: #9CA3AF;
  }

  /* Panel right — illustration */
  .panel-right {
    background: var(--surface-footer);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  .panel-illustration {
    width: 100%;
    max-width: 220px;
    position: relative;
    z-index: 1;
  }

  /* Progress dots */
  .tour-progress {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 20px;
  }
  .progress-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 200ms ease,
                transform 200ms ease;
  }
  .progress-dot:hover { background: #9CA3AF; }
  .progress-dot.active {
    background: var(--color-primary);
    transform: scale(1.35);
  }
  .progress-dot.completed {
    background: var(--color-primary-light);
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }
  .progress-dot:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Navigation */
  .tour-nav {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
  }
  .tour-nav-btn {
    padding: 11px 24px;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: 2px solid var(--color-border);
    background: var(--surface-base);
    color: #374151;
    transition: border-color 150ms ease,
                color 150ms ease,
                transform 150ms ease;
  }
  .tour-nav-btn:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .tour-nav-btn:active:not(:disabled) { transform: scale(0.98); }
  .tour-nav-btn:disabled {
    opacity: 0.38;
    cursor: not-allowed;
  }
  .tour-nav-btn.primary {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }
  .tour-nav-btn.primary:hover:not(:disabled) {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }
  .tour-nav-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Final CTA */
  .tour-final-cta {
    text-align: center;
    padding: 36px 24px;
    background: var(--surface-footer);
    border-radius: 12px;
  }
  .tour-final-cta p {
    font-family: var(--font-body);
    font-size: 16px;
    color: rgba(255,255,255,0.80);
    margin-bottom: 20px;
    line-height: 1.6;
  }
  .tour-cta-btn {
    display: inline-block;
    padding: 14px 28px;
    background: var(--color-accent);
    color: white;
    border-radius: 8px;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(230,81,0,0.30);
    transition: transform 200ms cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 200ms ease;
  }
  .tour-cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(230,81,0,0.40);
  }
  .tour-cta-btn:active { transform: translateY(0); }
  .tour-cta-btn:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .tour-panel {
      grid-template-columns: 1fr;
    }
    .panel-right {
      height: 200px;
      order: -1;
    }
    .panel-left { padding: 24px 20px; }
    .tour-step-btn { min-width: 75px; padding: 10px 8px; }
    .step-title { font-size: 10px; }
    .system-tour-section { padding: 48px 16px; }
    .stat-value { font-size: 32px; }
  }
</style>

<script>
  interface Stat {
    value: string;
    unit: string;
    label: string;
  }

  interface Step {
    number: string;
    title: string;
    subtitle: string;
    description: string;
    detail: string;
    stat: Stat;
  }

  const tourSection = document.querySelector<HTMLElement>(".system-tour-section");
  const cityName = tourSection?.dataset.city ?? "";
  const gpgLow = tourSection?.dataset.gpgLow ?? "";
  const gpgHigh = tourSection?.dataset.gpgHigh ?? "";
  const waterAuthority = tourSection?.dataset.waterAuthority ?? "";
  const waterSource = tourSection?.dataset.waterSource ?? "";

  const steps: Step[] = [
    {
      number: "01",
      title: "Pre-Filtration",
      subtitle: "Sediment and particles removed first",
      description:
        `Water from ${cityName}'s ${waterSource} supply enters the system and passes through a high-capacity sediment pre-filter. This removes rust particles, sand, and larger debris before the water reaches the softening resin — protecting the resin bed and extending the life of the whole system.`,
      detail:
        `${cityName} water from ${waterAuthority} travels through extensive municipal infrastructure before reaching your home. Pre-filtration catches particles picked up along the way — essential for a system designed to last 15–20 years.`,
      stat: { value: "5", unit: "microns", label: "particle size removed" },
    },
    {
      number: "02",
      title: "Ion Exchange Softening",
      subtitle: `Calcium and magnesium removed from ${cityName} water`,
      description:
        `This is the core of the softening process. Water flows through a resin tank packed with tiny beads carrying sodium ions. At ${cityName}'s ${gpgLow}–${gpgHigh} GPG hardness level the calcium and magnesium ions in the water swap places with the sodium ions on the resin — a process called ion exchange. The hardness minerals stay on the resin. Softened water flows out.`,
      detail:
        `${cityName}'s ${gpgLow}–${gpgHigh} GPG reading means every gallon carries roughly ${gpgLow}–${gpgHigh} grains of dissolved calcium and magnesium. Ion exchange removes them completely — not just crystallizes them the way salt-free conditioners do. The result is genuinely soft water throughout the home.`,
      stat: { value: "99%", unit: "", label: "of hardness minerals removed" },
    },
    {
      number: "03",
      title: "Resin Regeneration",
      subtitle: "System recharges automatically overnight",
      description:
        "The resin beads eventually become saturated with calcium and magnesium and need recharging. During regeneration — typically scheduled overnight when water use is lowest — a brine solution flushes through the resin tank. The sodium in the brine displaces the hardness minerals back off the resin, they drain away, and the resin is ready to soften again.",
      detail:
        "Modern softeners like the SpringWell systems we recommend use demand-initiated regeneration — the system only regenerates when it calculates the resin is near saturation based on actual water usage. This saves salt and water compared to older timer-based systems that regenerate on a fixed schedule.",
      stat: { value: "48", unit: "hrs", label: "average regeneration cycle" },
    },
    {
      number: "04",
      title: "Soft Water Delivered",
      subtitle: "Softened water flows to every tap in the home",
      description:
        "Softened water — with calcium and magnesium removed — flows out of the softener and into your home's plumbing. Every tap, shower, dishwasher, washing machine, and water-using appliance receives the same soft water. Scale stops forming. Existing light scale gradually dissolves. Soap and shampoo lather properly. Appliances run at full efficiency.",
      detail:
        `For ${cityName} homes at ${gpgLow}–${gpgHigh} GPG the difference is immediate and visible. Shower glass stays clear. Dishes come out of the dishwasher without white spots. Skin and hair feel different after the first shower. Water heaters, dishwashers, and washing machines stop accumulating the scale that was shortening their lifespan.`,
      stat: { value: "15–20", unit: "yrs", label: "typical system lifespan" },
    },
  ];

  function getIllustration(index: number): string {
    const dotGrid = `<defs>
      <pattern id="dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.04)"/>
      </pattern>
    </defs>
    <rect width="200" height="220" fill="url(#dots)"/>`;

    const illustrations = [
      // Step 1 — Pre-filtration
      `<svg viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%">
        ${dotGrid}
        <rect x="75" y="30" width="50" height="150" rx="8" fill="#0F6E78" fill-opacity="0.25" stroke="#0F6E78" stroke-width="1.5"/>
        <rect x="75" y="72"  width="50" height="5" fill="#0F6E78" fill-opacity="0.7"/>
        <rect x="75" y="90"  width="50" height="5" fill="#0F6E78" fill-opacity="0.55"/>
        <rect x="75" y="108" width="50" height="5" fill="#0F6E78" fill-opacity="0.40"/>
        <rect x="75" y="126" width="50" height="5" fill="#0F6E78" fill-opacity="0.25"/>
        <circle cx="88"  cy="80"  r="3" fill="#E65100" fill-opacity="0.9"/>
        <circle cx="112" cy="98"  r="3" fill="#E65100" fill-opacity="0.8"/>
        <circle cx="95"  cy="116" r="3" fill="#E65100" fill-opacity="0.7"/>
        <circle cx="108" cy="84"  r="2" fill="#E65100" fill-opacity="0.6"/>
        <line x1="100" y1="8"  x2="100" y2="26" stroke="rgba(255,255,255,0.4)" stroke-width="2" stroke-linecap="round"/>
        <polyline points="95,20 100,27 105,20" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="100" y1="184" x2="100" y2="208" stroke="#0F6E78" stroke-width="2.5" stroke-linecap="round"/>
        <polyline points="95,202 100,210 105,202" stroke="#0F6E78" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <text x="100" y="52" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="Inter,sans-serif" font-size="9" letter-spacing="0.05em">SEDIMENT FILTER</text>
        <circle cx="68" cy="210" r="4" fill="#E65100" fill-opacity="0.8"/>
        <text x="76" y="213" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="8">Particles caught</text>
      </svg>`,

      // Step 2 — Ion Exchange
      `<svg viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%">
        ${dotGrid}
        <rect x="50" y="20" width="100" height="160" rx="10" fill="#0F6E78" fill-opacity="0.15" stroke="#0F6E78" stroke-width="1.5"/>
        <circle cx="75"  cy="65" r="10" fill="#0F6E78" fill-opacity="0.6"/>
        <circle cx="100" cy="65" r="10" fill="#0F6E78" fill-opacity="0.6"/>
        <circle cx="125" cy="65" r="10" fill="#0F6E78" fill-opacity="0.6"/>
        <text x="75"  y="68" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7.5" font-weight="700">Na+</text>
        <text x="100" y="68" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7.5" font-weight="700">Na+</text>
        <text x="125" y="68" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7.5" font-weight="700">Na+</text>
        <line x1="75"  y1="80" x2="75"  y2="110" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-dasharray="3 2"/>
        <line x1="100" y1="80" x2="100" y2="110" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-dasharray="3 2"/>
        <line x1="125" y1="80" x2="125" y2="110" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" stroke-dasharray="3 2"/>
        <circle cx="75"  cy="123" r="10" fill="#E65100" fill-opacity="0.85"/>
        <circle cx="100" cy="123" r="10" fill="#E65100" fill-opacity="0.85"/>
        <circle cx="125" cy="123" r="10" fill="#E65100" fill-opacity="0.85"/>
        <text x="75"  y="126" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7" font-weight="700">Ca2+</text>
        <text x="100" y="126" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7" font-weight="700">Mg2+</text>
        <text x="125" y="126" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7" font-weight="700">Ca2+</text>
        <text x="100" y="170" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-family="Inter,sans-serif" font-size="8" letter-spacing="0.05em">ION EXCHANGE RESIN</text>
        <circle cx="55" cy="200" r="5" fill="#E65100" fill-opacity="0.85"/>
        <text x="64" y="203" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="8">Hardness removed</text>
        <circle cx="55" cy="214" r="5" fill="#0F6E78" fill-opacity="0.7"/>
        <text x="64" y="217" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="8">Na+ exchanged</text>
      </svg>`,

      // Step 3 — Regeneration
      `<svg viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%">
        ${dotGrid}
        <rect x="15" y="40" width="55" height="110" rx="6" fill="#0F6E78" fill-opacity="0.2" stroke="#0F6E78" stroke-width="1.5"/>
        <text x="42" y="88" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="Inter,sans-serif" font-size="9">BRINE</text>
        <text x="42" y="101" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="Inter,sans-serif" font-size="9">TANK</text>
        <polygon points="30,65 37,54 44,65" fill="white" fill-opacity="0.25"/>
        <polygon points="43,74 50,63 57,74" fill="white" fill-opacity="0.20"/>
        <polygon points="22,80 29,69 36,80" fill="white" fill-opacity="0.15"/>
        <line x1="70" y1="95" x2="108" y2="95" stroke="#0F6E78" stroke-width="2.5" stroke-linecap="round"/>
        <polyline points="101,89 109,95 101,101" stroke="#0F6E78" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="110" y="30" width="70" height="130" rx="8" fill="#0F6E78" fill-opacity="0.2" stroke="#0F6E78" stroke-width="1.5"/>
        <text x="145" y="88" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="Inter,sans-serif" font-size="9">RESIN</text>
        <text x="145" y="101" text-anchor="middle" fill="rgba(255,255,255,0.55)" font-family="Inter,sans-serif" font-size="9">TANK</text>
        <line x1="145" y1="165" x2="145" y2="195" stroke="#E65100" stroke-width="2.5" stroke-linecap="round"/>
        <polyline points="139,188 145,196 151,188" stroke="#E65100" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <circle cx="135" cy="173" r="4" fill="#E65100" fill-opacity="0.8"/>
        <circle cx="145" cy="180" r="4" fill="#E65100" fill-opacity="0.7"/>
        <circle cx="155" cy="173" r="4" fill="#E65100" fill-opacity="0.6"/>
        <text x="100" y="20" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-family="Inter,sans-serif" font-size="8" letter-spacing="0.05em">OVERNIGHT CYCLE</text>
        <text x="145" y="212" text-anchor="middle" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="8">DRAIN</text>
      </svg>`,

      // Step 4 — Soft Water Delivered
      `<svg viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg" width="100%">
        ${dotGrid}
        <path d="M100 18 L175 72 L175 195 L25 195 L25 72 Z" fill="#0F6E78" fill-opacity="0.10" stroke="#0F6E78" stroke-width="1.5"/>
        <path d="M100 18 L175 72 L25 72 Z" fill="#0F6E78" fill-opacity="0.20" stroke="#0F6E78" stroke-width="1.5"/>
        <rect x="86" y="138" width="28" height="50" rx="4" fill="#0F6E78" fill-opacity="0.7"/>
        <text x="100" y="168" text-anchor="middle" fill="white" font-family="Inter,sans-serif" font-size="7" font-weight="600">SOFT</text>
        <path d="M86 150 L55 150 L55 112" stroke="#0F6E78" stroke-width="2" stroke-linecap="round" fill="none"/>
        <circle cx="55" cy="110" r="5" fill="#0F6E78" fill-opacity="0.7"/>
        <path d="M114 150 L148 150 L148 112" stroke="#0F6E78" stroke-width="2" stroke-linecap="round" fill="none"/>
        <circle cx="148" cy="110" r="5" fill="#0F6E78" fill-opacity="0.7"/>
        <path d="M100 138 L100 106" stroke="#0F6E78" stroke-width="2" stroke-linecap="round" fill="none"/>
        <circle cx="100" cy="104" r="5" fill="#0F6E78" fill-opacity="0.7"/>
        <circle cx="100" cy="50" r="20" fill="#E65100" fill-opacity="0.9"/>
        <path d="M91 50 L97 57 L111 44" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <text x="55"  y="102" text-anchor="middle" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="7">Kitchen</text>
        <text x="148" y="102" text-anchor="middle" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="7">Bath</text>
        <text x="100" y="96"  text-anchor="middle" fill="rgba(255,255,255,0.45)" font-family="Inter,sans-serif" font-size="7">Laundry</text>
        <text x="100" y="214" text-anchor="middle" fill="rgba(255,255,255,0.5)" font-family="Inter,sans-serif" font-size="8" letter-spacing="0.05em">EVERY TAP · SOFT WATER</text>
      </svg>`,
    ];
    return illustrations[index] || "";
  }

  if (tourSection) {
    let current = 0;

    const stepBtns = tourSection.querySelectorAll<HTMLButtonElement>(".tour-step-btn");
    const connectors = tourSection.querySelectorAll<HTMLDivElement>(".step-connector");
    const dots = tourSection.querySelectorAll<HTMLButtonElement>(".progress-dot");
    const prevBtn = tourSection.querySelector<HTMLButtonElement>("#tour-prev");
    const nextBtn = tourSection.querySelector<HTMLButtonElement>("#tour-next");
    const finalCTA = tourSection.querySelector<HTMLDivElement>("#tour-final-cta");
    const panelLeft = tourSection.querySelector<HTMLDivElement>("#panel-left");
    const panelBadge = tourSection.querySelector<HTMLElement>("#panel-badge");
    const panelTitle = tourSection.querySelector<HTMLElement>("#panel-title");
    const panelSubtitle = tourSection.querySelector<HTMLElement>("#panel-subtitle");
    const panelDescription = tourSection.querySelector<HTMLElement>("#panel-description");
    const panelDetail = tourSection.querySelector<HTMLElement>("#panel-detail");
    const statValue = tourSection.querySelector<HTMLElement>("#stat-value");
    const statUnit = tourSection.querySelector<HTMLElement>("#stat-unit");
    const statLabel = tourSection.querySelector<HTMLElement>("#stat-label");
    const panelIllustration = tourSection.querySelector<HTMLElement>("#panel-illustration");

    function goToStep(index: number) {
      current = index;

      stepBtns.forEach((btn, i) => {
        btn.classList.toggle("active", i === index);
        btn.classList.toggle("completed", i < index);
        btn.setAttribute("aria-selected", i === index ? "true" : "false");
      });

      connectors.forEach((c, i) => c.classList.toggle("completed", i < index));

      dots.forEach((d, i) => {
        d.classList.toggle("active", i === index);
        d.classList.toggle("completed", i < index);
      });

      const s = steps[index];
      if (panelBadge) panelBadge.textContent = `Step ${s.number}`;
      if (panelTitle) panelTitle.textContent = s.title;
      if (panelSubtitle) panelSubtitle.textContent = s.subtitle;
      if (panelDescription) panelDescription.textContent = s.description;
      if (panelDetail) panelDetail.textContent = s.detail;
      if (statValue) statValue.textContent = s.stat.value;
      if (statUnit) statUnit.textContent = s.stat.unit;
      if (statLabel) statLabel.textContent = s.stat.label;
      if (panelIllustration) panelIllustration.innerHTML = getIllustration(index);

      if (panelLeft) {
        panelLeft.style.opacity = "0";
        panelLeft.style.transform = "translateY(8px)";
        requestAnimationFrame(() => {
          panelLeft.style.transition = "opacity 220ms ease, transform 220ms ease";
          panelLeft.style.opacity = "1";
          panelLeft.style.transform = "translateY(0)";
        });
      }

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.textContent = index === steps.length - 1 ? "↺ Start Over" : "Next Step →";
      if (finalCTA) finalCTA.style.display = index === steps.length - 1 ? "block" : "none";
    }

    stepBtns.forEach((btn, i) => btn.addEventListener("click", () => goToStep(i)));
    dots.forEach((dot, i) => dot.addEventListener("click", () => goToStep(i)));
    prevBtn?.addEventListener("click", () => {
      if (current > 0) goToStep(current - 1);
    });
    nextBtn?.addEventListener("click", () => {
      goToStep(current < steps.length - 1 ? current + 1 : 0);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight" && current < steps.length - 1) goToStep(current + 1);
      if (e.key === "ArrowLeft" && current > 0) goToStep(current - 1);
    });

    goToStep(0);
  }
</script>
