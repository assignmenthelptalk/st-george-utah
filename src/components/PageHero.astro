---
/**
 * PageHero — inner-page hero matching the home page: full-bleed background
 * photo with a dark overlay, content on the left and a compact lead-capture
 * form card on the right. On mobile the form stacks ABOVE the content.
 * Without a photo it falls back to the brand gradient. Pages that already
 * embed their own quote form (quote, contact) pass showForm={false}.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import QuoteForm from "./QuoteForm.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { site } from "../lib/site";

interface CtaLink {
  href: string;
  text: string;
}

interface Props {
  /** Omit (or pass []) for a page with no breadcrumb trail. */
  breadcrumbs?: Array<{ label: string; href?: string }>;
  heading: string;
  primaryCta: CtaLink;
  /** Omit to show a single call-to-action button. */
  secondaryCta?: CtaLink;
  /** Trust chips under the breadcrumbs. Defaults to claims every site can back (free estimate, no
   * obligation, service area). Add licence or same-day chips only once the business confirms them. */
  badges?: string[];
  /** Real photo used as the full-bleed hero background. Omit for the
   * brand-gradient fallback. */
  image?: ImageMetadata;
  /** Render the compact quote form in the right column (default true). */
  showForm?: boolean;
}

const {
  breadcrumbs = [],
  heading,
  primaryCta,
  secondaryCta,
  image,
  showForm = true,
  badges = ["✓ Free Estimate", "✓ No Obligation", `✓ Serving ${site.city}, ${site.stateAbbr}`],
} = Astro.props;
---

<section class="page-hero">
  {image && (
    <Image
      src={image}
      alt=""
      class="page-hero-bg-img"
      loading="eager"
      decoding="async"
      width={1600}
      height={700}
    />
  )}
  <div class="page-hero-bg" aria-hidden="true"></div>

  <div class={showForm ? "page-hero-inner" : "page-hero-inner page-hero-inner-single"}>
    <div class="page-hero-content">
      {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

      <div class="page-hero-badges">
        {badges.map((badge) => <span class="page-hero-badge">{badge}</span>)}
      </div>

      <h1 class="page-hero-h1">{heading}</h1>

      <div class="page-hero-opening">
        <slot name="opening" />
      </div>

      <div class="page-hero-ctas">
        <a href={primaryCta.href} class="page-hero-btn-primary">{primaryCta.text}</a>
        {secondaryCta && <a href={secondaryCta.href} class="page-hero-btn-secondary">{secondaryCta.text}</a>}
      </div>
    </div>

    {showForm && (
      <div class="page-hero-form" id="estimate">
        <QuoteForm heading="Get a FREE Quote" compact />
      </div>
    )}
  </div>
</section>

<style>
  /* ── PAGE HERO — SPLIT LAYOUT ── */
  .page-hero {
    position: relative;
    background: linear-gradient(135deg, var(--surface-footer) 0%, var(--color-primary-dark) 60%, var(--color-primary) 100%);
    overflow: hidden;
    min-height: 420px;
    display: flex;
    align-items: stretch;
  }

  /* Background photo, then overlay (gradient alone when there is no photo) */
  .page-hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
  }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(5, 20, 23, 0.86) 0%,
      rgba(5, 20, 23, 0.72) 45%,
      rgba(5, 20, 23, 0.5) 100%
    );
    z-index: 1;
  }

  /* Inner grid — two columns, exactly half/half on desktop */
  .page-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    width: 100%;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    min-height: 420px;
  }
  .page-hero-inner-single { grid-template-columns: 1fr; }

  /* LEFT — content column */
  .page-hero-content {
    padding: 56px 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    --breadcrumb-color: rgba(255, 255, 255, 0.65);
    --breadcrumb-hover-color: #ffffff;
    --breadcrumb-current-color: #ffffff;
  }
  .page-hero-content :global(.breadcrumbs) { padding: 0 0 14px; }

  /* Trust badges */
  .page-hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }
  .page-hero-badge {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.82);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    padding: 4px 10px;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  /* H1 */
  .page-hero-h1 {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.5vw, 42px);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  /* Opening paragraph — Glendale Elite pattern, moved up into the hero */
  .page-hero-opening {
    font-family: var(--font-body);
    font-size: 15px;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
    margin-bottom: 28px;
    max-width: 540px;
  }
  /* Any link in the opening paragraph (imported content uses plain anchors) */
  .page-hero-opening :global(a) {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .page-hero-opening :global(a:hover) { color: var(--color-accent-light); }
  .page-hero-opening :global(a:focus-visible) { outline: 3px solid #ffffff; outline-offset: 2px; border-radius: 2px; }
  .page-hero-opening :global(.brand-link) {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .page-hero-opening :global(.brand-link:hover) {
    color: rgba(255, 255, 255, 0.8);
  }
  .page-hero-opening :global(.brand-link:focus-visible) {
    outline: 3px solid #ffffff;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* CTA row */
  .page-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  /* Primary button — brand accent, not the spec's green */
  .page-hero-btn-primary {
    display: inline-block;
    padding: 13px 26px;
    background: var(--color-accent);
    color: #ffffff;
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(29, 78, 216, 0.28);
    transition: background-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
  }
  .page-hero-btn-primary:hover {
    background: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(29, 78, 216, 0.38);
  }
  .page-hero-btn-primary:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  .page-hero-btn-primary:active { transform: scale(0.98); }

  /* Secondary button — white outline */
  .page-hero-btn-secondary {
    display: inline-block;
    padding: 13px 26px;
    background: transparent;
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .page-hero-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #ffffff;
  }
  .page-hero-btn-secondary:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }
  .page-hero-btn-secondary:active { transform: scale(0.98); }

  /* RIGHT — compact quote form card (semi-transparent, as on the home page) */
  .page-hero-form { padding: 40px 0; }
  .page-hero-form :global(.quote-form) {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 24px 48px -16px rgba(5, 20, 23, 0.5);
  }

  /* Mobile — stack vertically, quote form above content */
  @media (max-width: 768px) {
    .page-hero { min-height: auto; }
    .page-hero-inner {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
      min-height: auto;
    }
    .page-hero-content {
      padding: 48px 20px 32px;
      align-items: center;
      text-align: center;
    }
    .page-hero-badges { justify-content: center; }
    .page-hero-opening { text-align: center; }
    .page-hero-ctas {
      justify-content: center;
      flex-direction: column;
      width: 100%;
    }
    .page-hero-btn-primary,
    .page-hero-btn-secondary {
      width: 100%;
      text-align: center;
    }
    /* Form first on mobile, content below */
    .page-hero-form { order: -1; padding: 24px 20px 0; }
  }
</style>
