---
/**
 * ServiceAreaLayout — shared template for every service area subpage.
 * Every value rendered here comes from the `ServiceArea` props object
 * (ultimately from site.config.ts's `serviceAreas` array) or from the
 * merged `site` singleton for business identity (phone, name) — never a
 * hardcoded city name, GPG figure, or neighbourhood anywhere in this file.
 */
import type { ServiceArea } from "../site.config";
import { site } from "../lib/site";
import QuoteForm from "./QuoteForm.astro";
import Breadcrumbs from "./Breadcrumbs.astro";

type Props = ServiceArea;

const {
  slug,
  city,
  stateAbbr,
  county,
  population,
  zipCodes,
  gpgLow,
  gpgHigh,
  gpgLabel,
  waterAuthority,
  waterSource,
  distanceFromPrimary,
  relationship,
  h1,
  h1Sub,
  heroStat,
  heroStatLabel,
  heroStatBadge,
  gpgNote,
  wqaNote,
  neighbourhoods,
  benefits,
  faqs,
  nearbyAreas,
  testimonial,
} = Astro.props;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.businessName || site.primaryKeyword,
  description: `Water softener installation and service in ${city}, ${stateAbbr}`,
  url: `${site.siteUrl}/${slug}/`,
  telephone: site.phoneNumber !== "PHONE_NUMBER" ? site.phoneNumber : undefined,
  areaServed: [
    {
      "@type": "City",
      name: city,
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: county,
      },
    },
  ],
  serviceType: "Water Softener Installation",
  priceRange: "$$",
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- Section 1 — Header bar -->
<div class="sa-header-bar">
  <div class="sa-breadcrumb">
    <Breadcrumbs items={[{ label: `${city}, ${stateAbbr}` }]} />
  </div>
  <div class="sa-header-right">
    {site.phoneNumber !== "PHONE_NUMBER" && (
      <a class="sa-header-phone" href={`tel:${site.phoneNumber}`}>{site.phoneNumber}</a>
    )}
    <a class="sa-header-cta" href="/quote/">Get a Free Water Test</a>
  </div>
</div>

<!-- Section 2 — Hero -->
<section class="sa-hero">
  <div class="sa-hero-inner">
    <div class="sa-trust-badges">
      <div class="sa-trust-badge">
        <span class="sa-trust-badge-value">{distanceFromPrimary}</span>
        <span class="sa-trust-badge-label">From {site.city}</span>
      </div>
      <div class="sa-trust-badge">
        <span class="sa-trust-badge-value">5★</span>
        <span class="sa-trust-badge-label">Star Rating</span>
      </div>
      <div class="sa-trust-badge">
        <span class="sa-trust-badge-value">Free</span>
        <span class="sa-trust-badge-label">Water Test</span>
      </div>
      <div class="sa-trust-badge">
        <span class="sa-trust-badge-value">Same Day</span>
        <span class="sa-trust-badge-label">Service</span>
      </div>
    </div>

    <h1>{h1}</h1>
    <p class="sa-h1-sub">{h1Sub}</p>

    <div class="sa-gpg-block">
      <span class="sa-gpg-stat">{heroStat}</span>
      <span class="sa-gpg-stat-label">{heroStatLabel}</span>
      <span class="sa-gpg-stat-badge">{heroStatBadge}</span>
    </div>

    <div class="sa-hero-ctas">
      <a class="sa-btn-primary" href="/quote/">Free Consultation</a>
      <a class="sa-btn-secondary" href="/comparison/">View Systems</a>
    </div>
  </div>
</section>

<!-- Section 3 — GPG data -->
<section class="sa-section">
  <div class="sa-section-inner">
    <h2 class="sa-h2">How Hard Is the Water in {city}, {stateAbbr}?</h2>
    <div class="sa-gpg-reading">
      <span class="sa-gpg-big">{gpgLow}–{gpgHigh}</span>
      <span class="sa-gpg-unit">GPG</span>
      <span class="sa-classification-badge">{gpgLabel.toUpperCase()}</span>
    </div>
    <p class="sa-gpg-note">{gpgNote}</p>
    <div class="sa-wqa-note">ℹ️ {wqaNote}</div>
    <p class="sa-water-authority">
      Source: {waterSource}, delivered by {waterAuthority}. Population: {population} ·
      ZIP Code{zipCodes.length > 1 ? "s" : ""}: {zipCodes.join(", ")} · {relationship}.
    </p>
    <a class="sa-gpg-cta" href="/quote/">Schedule a Free Water Test</a>

    <p class="brand-backlink">
      <a href="/" class="brand-link">{site.businessName}</a> also provides water softener installation and service to nearby {city} homeowners, such as free water testing and same-day scheduling.
    </p>
  </div>
</section>

<!-- Section 4 — Benefits -->
<section class="sa-section sa-section-alt">
  <div class="sa-section-inner">
    <h2 class="sa-h2">Benefits of Soft Water in Your {city} Home</h2>
    <ul class="sa-benefits-list">
      {benefits.map((benefit) => (
        <li class="sa-benefit-item">
          <span class="sa-benefit-icon" aria-hidden="true">✓</span>
          {benefit}
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- Section 5 — Neighbourhoods -->
<section class="sa-section">
  <div class="sa-section-inner">
    <h2 class="sa-h2">Neighborhoods &amp; Communities We Serve in {city}</h2>
    {neighbourhoods.length > 0 ? (
      <Fragment>
        <div class="sa-neighbourhood-grid">
          {neighbourhoods.map((n) => (
            <span class="sa-neighbourhood-pill" title={n.note ?? undefined}>{n.name}</span>
          ))}
        </div>
        <p class="sa-neighbourhood-note">We serve all of {county}.</p>
      </Fragment>
    ) : (
      <div class="sa-no-neighbourhoods">
        Service area neighbourhoods will be listed here after verification.
        Contact us to confirm service to your specific address.
      </div>
    )}
  </div>
</section>

<!-- Section 6 — Testimonial -->
<section class="sa-section sa-section-alt">
  <div class="sa-section-inner">
    <div class="sa-testimonial-card">
      <div class="sa-testimonial-stars" aria-hidden="true">★★★★★</div>
      <p class="sa-testimonial-quote">"{testimonial.quote}"</p>
      <div class="sa-testimonial-reviewer">
        <div class="sa-reviewer-avatar">{testimonial.name.charAt(0)}</div>
        <div>
          <span class="sa-reviewer-name">{testimonial.name}</span>
          <span class="sa-reviewer-location">{testimonial.location}</span>
        </div>
      </div>
      {testimonial.placeholder && (
        <span class="sa-placeholder-badge">Placeholder review — replace with real Google review after collecting</span>
      )}
    </div>
  </div>
</section>

<!-- Section 7 — FAQ accordion -->
<section class="sa-section">
  <div class="sa-section-inner">
    <h2 class="sa-h2">Common Questions About Water Softeners in {city}, {stateAbbr}</h2>
    <div class="sa-faq-list">
      {faqs.map((item) => (
        <details class="sa-faq-item">
          <summary>{item.question}</summary>
          <p class="sa-faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- Section 8 — Nearby service areas -->
<section class="sa-section sa-section-alt">
  <div class="sa-section-inner">
    <h2 class="sa-h2">Water Softener Service Near {city}</h2>
    <div class="sa-nearby-grid">
      <a class="sa-nearby-link" href="/">{site.city}, {site.stateAbbr}</a>
      {nearbyAreas.map((area) => (
        <a class="sa-nearby-link" href={area.slug}>{area.name}</a>
      ))}
    </div>
  </div>
</section>

<!-- Section 9 — Lead capture -->
<section class="sa-section">
  <div class="sa-section-inner sa-lead-grid">
    <div>
      <h2 class="sa-h2">Get Your Free Water Analysis in {city}, {stateAbbr}</h2>
      <ul class="sa-lead-bullets">
        <li class="sa-lead-bullet"><span class="sa-lead-bullet-check" aria-hidden="true">✓</span> Free in-home water hardness test</li>
        <li class="sa-lead-bullet"><span class="sa-lead-bullet-check" aria-hidden="true">✓</span> No-obligation quote</li>
        <li class="sa-lead-bullet"><span class="sa-lead-bullet-check" aria-hidden="true">✓</span> Same-day service available in {city}</li>
        <li class="sa-lead-bullet"><span class="sa-lead-bullet-check" aria-hidden="true">✓</span> {county} licensed and insured</li>
      </ul>
    </div>
    <QuoteForm heading={`Get Your Free ${city} Water Analysis`} />
  </div>
</section>

<style>
  /* ── HEADER BAR ── */
  .sa-header-bar {
    background: var(--surface-footer);
    padding: 10px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }
  .sa-header-bar :global(.breadcrumbs) { padding: 0; }
  .sa-header-bar :global(.breadcrumbs li) { color: rgba(255,255,255,0.70); }
  .sa-header-bar :global(.breadcrumbs a) { color: rgba(255,255,255,0.70); }
  .sa-header-bar :global(.breadcrumbs a:hover) { color: #ffffff; }
  .sa-header-bar :global(.breadcrumbs li[aria-current="page"]) { color: #ffffff; }
  .sa-header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .sa-header-phone {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: white;
    text-decoration: none;
    transition: color 150ms ease;
  }
  .sa-header-phone:hover { color: var(--color-primary-light); }
  .sa-header-phone:focus-visible { outline: 3px solid var(--color-primary-light); outline-offset: 2px; }
  .sa-header-cta {
    padding: 8px 16px;
    background: var(--color-accent);
    color: white;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
    box-shadow: 0 2px 6px rgba(230,81,0,0.25);
  }
  .sa-header-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(230,81,0,0.35); }
  .sa-header-cta:focus-visible { outline: 3px solid white; outline-offset: 2px; }
  .sa-header-cta:active { transform: scale(0.98); }

  /* ── HERO ── */
  .sa-hero {
    background: var(--gradient-primary);
    padding: 64px 24px;
    color: white;
    position: relative;
    overflow: hidden;
  }
  .sa-hero-inner {
    max-width: 860px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }
  .sa-trust-badges {
    display: flex;
    gap: 32px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }
  .sa-trust-badge {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .sa-trust-badge-value {
    font-family: var(--font-heading);
    font-size: 26px;
    color: white;
    line-height: 1;
  }
  .sa-trust-badge-label {
    font-family: var(--font-body);
    font-size: 11px;
    color: rgba(255,255,255,0.60);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sa-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(32px, 5vw, 52px);
    letter-spacing: -0.03em;
    color: white;
    margin-bottom: 10px;
    line-height: 1.1;
  }
  .sa-h1-sub {
    font-family: var(--font-body);
    font-size: 17px;
    color: rgba(255,255,255,0.70);
    margin-bottom: 28px;
  }
  .sa-gpg-block {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
    padding: 18px 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .sa-gpg-stat {
    font-family: var(--font-heading);
    font-size: 48px;
    color: white;
    line-height: 1;
  }
  .sa-gpg-stat-label {
    font-family: var(--font-body);
    font-size: 13px;
    color: rgba(255,255,255,0.65);
  }
  .sa-gpg-stat-badge {
    padding: 4px 12px;
    background: #FEE2E2;
    color: #991B1B;
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .sa-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sa-btn-primary {
    padding: 14px 28px;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(230,81,0,0.30);
    transition: transform 200ms var(--ease-spring), box-shadow 200ms ease;
  }
  .sa-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(230,81,0,0.40); }
  .sa-btn-primary:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .sa-btn-primary:active { transform: scale(0.98); }
  .sa-btn-secondary {
    padding: 14px 28px;
    background: transparent;
    color: white;
    border: 2px solid rgba(255,255,255,0.40);
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }
  .sa-btn-secondary:hover { border-color: white; background: rgba(255,255,255,0.08); }
  .sa-btn-secondary:focus-visible { outline: 3px solid white; outline-offset: 2px; }
  .sa-btn-secondary:active { background: rgba(255,255,255,0.16); }

  /* ── SECTION BASE ── */
  .sa-section { padding: 72px 24px; }
  .sa-section-inner { max-width: 960px; margin: 0 auto; }
  .sa-section-alt { background: var(--surface-elevated); }
  .sa-h2 {
    font-family: var(--font-heading);
    font-size: clamp(24px, 3.5vw, 38px);
    letter-spacing: -0.02em;
    color: var(--surface-footer);
    margin-bottom: 28px;
    line-height: 1.2;
  }

  /* ── GPG DATA SECTION ── */
  .sa-gpg-reading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .sa-gpg-big {
    font-family: var(--font-heading);
    font-size: 64px;
    color: var(--color-primary);
    line-height: 1;
  }
  .sa-gpg-unit {
    font-family: var(--font-body);
    font-size: 20px;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .sa-classification-badge {
    padding: 5px 14px;
    background: #FEE2E2;
    color: #991B1B;
    border-radius: 20px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .sa-gpg-note {
    font-family: var(--font-body);
    font-size: 15px;
    color: #374151;
    line-height: 1.75;
    padding: 14px 16px;
    border-left: 3px solid var(--color-primary);
    background: var(--surface-elevated);
    border-radius: 0 6px 6px 0;
    margin-bottom: 16px;
  }
  .sa-wqa-note {
    background: #EFF6FF;
    border-radius: var(--radius-brand);
    padding: 13px 16px;
    font-family: var(--font-body);
    font-size: 13px;
    color: #1E40AF;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
  }
  .sa-water-authority {
    font-family: var(--font-body);
    font-size: 12px;
    color: #9CA3AF;
    margin-bottom: 28px;
  }
  .sa-gpg-cta {
    display: inline-block;
    padding: 12px 24px;
    background: var(--color-primary);
    color: white;
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
    box-shadow: 0 2px 8px rgba(15,110,120,0.25);
  }
  .sa-gpg-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(15,110,120,0.35); }
  .sa-gpg-cta:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .sa-gpg-cta:active { transform: scale(0.98); }

  /* ── BENEFITS ── */
  .sa-benefits-list {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sa-benefit-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-family: var(--font-body);
    font-size: 15px;
    color: #374151;
    line-height: 1.65;
  }
  .sa-benefit-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-primary-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
  }

  /* ── NEIGHBOURHOODS ── */
  .sa-neighbourhood-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
  }
  .sa-neighbourhood-pill {
    padding: 8px 18px;
    background: var(--surface-base);
    border: 1.5px solid var(--color-border);
    border-radius: 24px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: #374151;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .sa-neighbourhood-pill:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .sa-neighbourhood-note {
    font-family: var(--font-body);
    font-size: 12px;
    color: #9CA3AF;
    margin-top: 8px;
  }
  .sa-no-neighbourhoods {
    background: #FFF7ED;
    border: 1px solid #FED7AA;
    border-radius: var(--radius-brand);
    padding: 16px 20px;
    font-family: var(--font-body);
    font-size: 14px;
    color: #92400E;
    line-height: 1.6;
  }

  /* ── TESTIMONIAL ── */
  .sa-testimonial-card {
    background: var(--surface-footer);
    border-radius: 16px;
    padding: 36px;
  }
  .sa-testimonial-stars {
    font-size: 20px;
    color: #F59E0B;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .sa-testimonial-quote {
    font-family: var(--font-body);
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    line-height: 1.75;
    font-style: italic;
    margin-bottom: 20px;
  }
  .sa-testimonial-reviewer {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .sa-reviewer-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-family: var(--font-heading);
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sa-reviewer-name {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: white;
    display: block;
  }
  .sa-reviewer-location {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-primary-light);
    display: block;
  }
  .sa-placeholder-badge {
    display: inline-block;
    margin-top: 10px;
    padding: 3px 10px;
    background: rgba(230,81,0,0.18);
    border: 1px solid rgba(230,81,0,0.28);
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 10px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  /* ── FAQ ACCORDION ── */
  .sa-faq-list {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  details.sa-faq-item { border-bottom: 1px solid var(--color-border); }
  details.sa-faq-item:last-child { border-bottom: none; }
  details.sa-faq-item summary {
    padding: 20px 24px;
    font-family: var(--font-heading);
    font-size: 17px;
    color: var(--surface-footer);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    transition: background-color 150ms ease;
    user-select: none;
  }
  details.sa-faq-item summary:hover { background: var(--surface-elevated); }
  details.sa-faq-item summary:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; }
  details.sa-faq-item summary::after {
    content: '+';
    font-family: var(--font-body);
    font-size: 22px;
    color: var(--color-primary);
    font-weight: 300;
    flex-shrink: 0;
    line-height: 1;
  }
  details.sa-faq-item[open] summary::after { content: '\2212'; }
  details.sa-faq-item summary::-webkit-details-marker { display: none; }
  details.sa-faq-item summary::marker { content: ""; }
  .sa-faq-answer {
    padding: 4px 24px 22px;
    font-family: var(--font-body);
    font-size: 15px;
    color: #4B5563;
    line-height: 1.75;
  }

  /* ── NEARBY AREAS ── */
  .sa-nearby-grid { display: flex; flex-wrap: wrap; gap: 10px; }
  .sa-nearby-link {
    padding: 10px 20px;
    background: var(--surface-base);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-brand);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease, transform 150ms ease;
  }
  .sa-nearby-link:hover { border-color: var(--color-primary); color: var(--color-primary); transform: translateY(-1px); }
